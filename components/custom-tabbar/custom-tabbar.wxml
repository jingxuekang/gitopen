<view class="tabbar">
  <view
    class="tabbar-item {{currentTab === 0 ? 'active' : ''}}"
    bindtap="switchTab"
    data-index="0"
    data-url="/pages/index/index"
  >
    <view class="tab-icon icon-home">
      <view class="home-roof"></view>
      <view class="home-body"></view>
    </view>
    <text class="tabbar-text">首页</text>
  </view>
  <view
    class="tabbar-item {{currentTab === 1 ? 'active' : ''}}"
    bindtap="switchTab"
    data-index="1"
    data-url="/pages/category/category"
  >
    <view class="tab-icon icon-category">
      <view class="grid-dot"></view>
      <view class="grid-dot"></view>
      <view class="grid-dot"></view>
      <view class="grid-dot"></view>
    </view>
    <text class="tabbar-text">分类</text>
  </view>
  <view
    class="tabbar-item {{currentTab === 2 ? 'active' : ''}}"
    bindtap="switchTab"
    data-index="2"
    data-url="/pages/cart/cart"
  >
    <view class="tab-icon icon-cart">
      <view class="cart-bag"></view>
      <view class="cart-handle"></view>
    </view>
    <text wx:if="{{cartCount > 0}}" class="tab-badge">{{cartCount > 99 ? '99+' : cartCount}}</text>
    <text class="tabbar-text">购物车</text>
  </view>
  <view
    class="tabbar-item {{currentTab === 3 ? 'active' : ''}}"
    bindtap="switchTab"
    data-index="3"
    data-url="/pages/user/user"
  >
    <view class="tab-icon icon-user">
      <view class="user-head"></view>
      <view class="user-body"></view>
    </view>
    <text class="tabbar-text">我的</text>
  </view>
</view>
