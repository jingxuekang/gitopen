.order-item {
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid #EFE5D7;
  box-shadow: 0 8rpx 20rpx rgba(67, 45, 20, 0.06);
  padding: 20rpx;
  box-sizing: border-box;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-no {
  color: #907D65;
  font-size: 23rpx;
}

.order-status {
  color: #8b6914;
  font-size: 24rpx;
  font-weight: 600;
}

.goods-list {
  margin-top: 16rpx;
  padding: 6rpx 0;
}

.goods-item {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #F3ECE1;
}

.goods-item:last-child {
  margin-bottom: 0;
  border-bottom: none;
}

.goods-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  min-width: 0;
  margin: 0 14rpx;
}

.goods-name {
  display: block;
  color: #2f2a22;
  font-size: 28rpx;
  line-height: 1.4;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

.goods-spec {
  margin-top: 8rpx;
  display: block;
  font-size: 22rpx;
  color: #8b7b63;
}

.goods-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  color: #5f5442;
  font-size: 24rpx;
}

.item-price {
  color: #8b6914;
  font-size: 26rpx;
  font-weight: 600;
}

.item-quantity {
  color: #7a6b56;
  font-size: 22rpx;
}

.order-footer {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.order-amount {
  color: #2f2a22;
  font-size: 28rpx;
  font-weight: 600;
}

.actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  height: 54rpx;
  line-height: 54rpx;
  padding: 0 20rpx;
  border-radius: 27rpx;
  border: 1rpx solid #d8cfbe;
  color: #7E6A53;
  font-size: 23rpx;
  background: #FFFBF5;
}

.action-primary {
  border-color: #8b6914;
  background: #8b6914;
  color: #fff;
}
