.product-card {
  position: relative;
  display: flex;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid #EFE5D7;
  box-shadow: 0 8rpx 20rpx rgba(67, 45, 20, 0.06);
  box-sizing: border-box;
}

.product-image-wrap {
  width: 180rpx;
  height: 180rpx;
  border-radius: 14rpx;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
}

.product-image {
  width: 100%;
  height: 100%;
}

.group-tag {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(139, 105, 20, 0.92);
  color: #fff;
  font-size: 19rpx;
  font-weight: 500;
}

.product-info {
  margin-left: 18rpx;
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #2f2a22;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-meta {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}

.meta-text {
  font-size: 22rpx;
  color: #907D65;
}

.price-row {
  margin-top: 14rpx;
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex-wrap: wrap;
}

.price-symbol {
  color: #b8860b;
  font-size: 22rpx;
}

.price-value {
  color: #b8860b;
  font-size: 34rpx;
  font-weight: 700;
}

.member-price {
  margin-left: 8rpx;
  color: #9A825A;
  font-size: 21rpx;
}

.cart-btn {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 26rpx;
  background: #8b6914;
  color: #fff;
  font-size: 23rpx;
  font-weight: 500;
}

.layout-vertical {
  display: block;
  padding: 0;
  overflow: hidden;
}

.layout-vertical .product-image-wrap {
  width: 100%;
  height: 290rpx;
  border-radius: 0;
}

.layout-vertical .product-info {
  margin-left: 0;
  padding: 18rpx 18rpx 16rpx;
  min-height: 176rpx;
  box-sizing: border-box;
}

.layout-vertical .product-name {
  font-size: 27rpx;
  -webkit-line-clamp: 2;
}

.layout-vertical .cart-btn {
  position: static;
  display: inline-block;
  margin: 0 18rpx 18rpx auto;
}
