<!-- 骨架屏组件 -->
<view class="skeleton {{type}}">
  <!-- 商品卡片骨架屏 -->
  <view wx:if="{{type === 'product-card'}}" class="skeleton-product-card">
    <view class="skeleton-image"></view>
    <view class="skeleton-content">
      <view class="skeleton-line skeleton-title"></view>
      <view class="skeleton-line skeleton-price"></view>
      <view class="skeleton-line skeleton-sales"></view>
    </view>
  </view>

  <!-- 商品详情骨架屏 -->
  <view wx:elif="{{type === 'product-detail'}}" class="skeleton-product-detail">
    <view class="skeleton-swiper"></view>
    <view class="skeleton-info">
      <view class="skeleton-line skeleton-price-large"></view>
      <view class="skeleton-line skeleton-title-large"></view>
      <view class="skeleton-line skeleton-meta"></view>
    </view>
  </view>

  <!-- 订单卡片骨架屏 -->
  <view wx:elif="{{type === 'order-card'}}" class="skeleton-order-card">
    <view class="skeleton-header">
      <view class="skeleton-line skeleton-order-no"></view>
    </view>
    <view class="skeleton-body">
      <view class="skeleton-image-small"></view>
      <view class="skeleton-content">
        <view class="skeleton-line skeleton-title"></view>
        <view class="skeleton-line skeleton-price"></view>
      </view>
    </view>
  </view>

  <!-- 列表骨架屏 -->
  <view wx:elif="{{type === 'list'}}" class="skeleton-list">
    <view class="skeleton-list-item" wx:for="{{count || 3}}" wx:key="index">
      <view class="skeleton-line skeleton-title"></view>
      <view class="skeleton-line skeleton-subtitle"></view>
    </view>
  </view>
</view>
