/* components/nav-header/nav-header.wxss */
.nav-header {
  background: linear-gradient(135deg, #8B6914 0%, #A67C1A 50%, #8B6914 100%);
  box-shadow: 0 4rpx 20rpx rgba(139, 105, 20, 0.25);
  width: 100%;
  box-sizing: border-box;
  padding: 0 24rpx 14rpx;
  flex-shrink: 0;
}

/* 状态栏精确占位 */
.nav-status-bar {
  width: 100%;
}

/* 导航内容行 */
.nav-content {
  height: 72rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.nav-back {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 8rpx;
}

.back-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #FFF8E8;
  border-bottom: 4rpx solid #FFF8E8;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

/* Logo + 标题居中 */
.nav-logo-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.nav-logo {
  width: 48rpx;
  height: 48rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.14);
}

/* 与首页 brand-name 完全一致 */
.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFF8E8;
  letter-spacing: 2rpx;
}

.nav-right {
  margin-left: auto;
  display: flex;
  align-items: center;
}
