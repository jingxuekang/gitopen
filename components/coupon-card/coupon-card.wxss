.coupon-card {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid #EFE5D7;
  box-shadow: 0 8rpx 20rpx rgba(67, 45, 20, 0.06);
  overflow: hidden;
}

.left {
  width: 168rpx;
  background: linear-gradient(180deg, #b8860b, #8b6914);
  color: #fff;
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding-top: 34rpx;
  box-sizing: border-box;
}

.currency {
  font-size: 26rpx;
}

.amount {
  font-size: 52rpx;
  font-weight: 700;
}

.main {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
  min-width: 0;
}

.title {
  display: block;
  color: #2f2a22;
  font-size: 29rpx;
  font-weight: 600;
}

.desc {
  margin-top: 8rpx;
  display: block;
  color: #6f634f;
  font-size: 24rpx;
}

.expire {
  margin-top: 8rpx;
  display: block;
  color: #9a8a71;
  font-size: 22rpx;
}

.right {
  width: 136rpx;
  border-left: 1rpx dashed #e8dfcf;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.status {
  color: #8b7b63;
  font-size: 22rpx;
}

.action {
  min-width: 92rpx;
  text-align: center;
  border-radius: 24rpx;
  line-height: 44rpx;
  font-size: 22rpx;
  color: #fff;
  background: #8b6914;
  padding: 0 12rpx;
}

.coupon-card.status-used,
.coupon-card.status-expired {
  opacity: 0.55;
}

.coupon-card.is-selected {
  box-shadow: 0 0 0 2rpx #b8860b inset;
}
