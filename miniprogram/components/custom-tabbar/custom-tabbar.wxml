<view class="tabbar">
  <view 
    class="tabbar-item {{currentTab === 0 ? 'active' : ''}}" 
    bindtap="switchTab" 
    data-index="0"
    data-url="/pages/index/index"
  >
    <text class="tabbar-text">首页</text>
  </view>
  <view 
    class="tabbar-item {{currentTab === 1 ? 'active' : ''}}" 
    bindtap="switchTab" 
    data-index="1"
    data-url="/pages/category/category"
  >
    <text class="tabbar-text">分类</text>
  </view>
  <view 
    class="tabbar-item {{currentTab === 2 ? 'active' : ''}}" 
    bindtap="switchTab" 
    data-index="2"
    data-url="/pages/cart/cart"
  >
    <text class="tabbar-text">购物车</text>
  </view>
  <view 
    class="tabbar-item {{currentTab === 3 ? 'active' : ''}}" 
    bindtap="switchTab" 
    data-index="3"
    data-url="/pages/user/user"
  >
    <text class="tabbar-text">我的</text>
  </view>
</view>
