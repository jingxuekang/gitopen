/* pages/user/user.wxss */
.user-page {
  min-height: 100vh;
  background-color: #F7F4F0;
}

/* 用户信息区域 */
.user-header {
  background: linear-gradient(135deg, #5B3A29 0%, #7A5233 50%, #8B6914 100%);
  padding: 60rpx 30rpx 30rpx;
  color: #FFFFFF;
  border-radius: 0 0 40rpx 40rpx;
  position: relative;
  overflow: hidden;
}

.user-header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(212, 175, 55, 0.4);
}

.info {
  flex: 1;
  margin-left: 30rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 10rpx;
}

.member-badge {
  display: inline-block;
  background: linear-gradient(135deg, #D4AF37 0%, #F4D03F 100%);
  color: #5B3A29;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
}

/* 未登录状态 */
.login-prompt {
  display: flex;
  align-items: center;
}

.login-btn {
  margin-left: 30rpx;
  background: linear-gradient(135deg, #FFF8E7 0%, #F5ECD3 100%);
  color: #5B3A29;
  border-radius: 44rpx;
  padding: 24rpx 60rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 20rpx rgba(91, 58, 41, 0.2);
  transition: all 0.2s;
}

.login-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(91, 58, 41, 0.3);
}

/* 会员升级进度 */
.member-progress {
  margin-top: 30rpx;
  padding: 20rpx;
  background-color: rgba(255, 248, 231, 0.2);
  border-radius: 12rpx;
}

.progress-text {
  font-size: 24rpx;
  margin-bottom: 10rpx;
  opacity: 0.9;
}

.progress-bar {
  height: 8rpx;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #D4AF37 0%, #F4D03F 100%);
  transition: width 0.3s;
}

/* 会员权益 */
.member-benefits {
  margin-top: 20rpx;
  padding: 24rpx;
  background-color: rgba(255, 248, 231, 0.15);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(212, 175, 55, 0.2);
}

.benefits-title {
  font-size: 26rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
  opacity: 0.9;
}

.benefits-list {
  display: flex;
  flex-wrap: wrap;
}

.benefit-item {
  display: flex;
  align-items: center;
  width: 50%;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.benefit-check {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #D4AF37;
  line-height: 28rpx;
}

.benefit-text {
  flex: 1;
}

/* 订单统计 */
.order-stats {
  display: flex;
  background-color: #FFFFFF;
  padding: 30rpx 0;
  margin-top: -20rpx;
  border-radius: 20rpx 20rpx 0 0;
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-count {
  font-size: 40rpx;
  font-weight: bold;
  color: #5B3A29;
  margin-bottom: 10rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #B8A898;
}

/* 功能列表 */
.function-list {
  padding: 20rpx 30rpx;
}

.function-group {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.function-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #F0EBE5;
}

.function-item:last-child {
  border-bottom: none;
}

.item-left {
  display: flex;
  align-items: center;
}

.item-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.item-label {
  font-size: 28rpx;
  color: #3D2B1F;
}

.arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.3;
}

/* 功能按钮 */
.action-buttons {
  display: flex;
  justify-content: space-around;
  margin-top: 30rpx;
  padding: 0 20rpx;
}

.action-btn {
  flex: 1;
  margin: 0 10rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 44rpx;
  border: none;
  font-weight: 500;
  transition: all 0.2s;
}

.action-btn::after {
  border: none;
}

.recharge-btn {
  background: linear-gradient(135deg, #8B6914 0%, #D4AF37 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(139, 105, 20, 0.3);
}

.withdraw-btn {
  background: linear-gradient(135deg, #2E86AB 0%, #48B8D0 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(46, 134, 171, 0.3);
}

.edit-btn {
  background: linear-gradient(135deg, #B8A898 0%, #D4C5B5 100%);
  color: #3D2B1F;
  box-shadow: 0 8rpx 20rpx rgba(184, 168, 152, 0.3);
}

.action-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(91, 58, 41, 0.2);
}