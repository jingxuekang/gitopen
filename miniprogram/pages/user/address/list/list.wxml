<!-- 地址列表页面 -->
<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 地址列表 -->
  <view wx:elif="{{addresses.length > 0}}" class="address-list">
    <view 
      class="address-item {{item.isDefault ? 'default' : ''}}" 
      wx:for="{{addresses}}" 
      wx:key="_id"
      bindtap="{{mode === 'select' ? 'onSelectAddress' : ''}}"
      data-id="{{item._id}}"
    >
      <!-- 默认标签 -->
      <view wx:if="{{item.isDefault}}" class="default-badge">默认</view>

      <!-- 地址信息 -->
      <view class="address-info">
        <view class="name-phone">
          <text class="name">{{item.name}}</text>
          <text class="phone">{{item.phone}}</text>
        </view>
        <view class="address-detail">
          {{item.province}} {{item.city}} {{item.district}} {{item.detail}}
        </view>
      </view>

      <!-- 操作按钮（管理模式） -->
      <view wx:if="{{mode === 'manage'}}" class="action-buttons" catchtap="stopPropagation">
        <button 
          wx:if="{{!item.isDefault}}" 
          class="action-btn set-default" 
          bindtap="onSetDefault" 
          data-id="{{item._id}}"
        >
          设为默认
        </button>
        <button class="action-btn edit" bindtap="onEditAddress" data-id="{{item._id}}">
          编辑
        </button>
        <button class="action-btn delete" bindtap="onDeleteAddress" data-id="{{item._id}}">
          删除
        </button>
      </view>

      <!-- 选中图标（选择模式） -->
      <view wx:if="{{mode === 'select'}}" class="select-icon">
        <text>›</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="empty">
    <image class="empty-icon" src="/images/empty/address.png" mode="aspectFit"></image>
    <text class="empty-text">暂无收货地址</text>
    <button class="add-button" bindtap="onAddAddress">添加地址</button>
  </view>
</view>

<!-- 底部添加按钮 -->
<view wx:if="{{addresses.length > 0}}" class="bottom-bar">
  <button class="add-address-button" bindtap="onAddAddress">
    + 添加新地址
  </button>
</view>
