<!-- 优惠券选择页面 -->
<view class="container">
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{coupons.length === 0}}" class="empty">
    <text class="empty-icon">🎫</text>
    <text class="empty-text">暂无可用优惠券</text>
  </view>

  <view wx:else class="coupons-list">
    <!-- 不使用优惠券选项 -->
    <view class="coupon-item {{!selectedCouponId ? 'selected' : ''}}" bindtap="onSelectCoupon" data-id="">
      <view class="coupon-content">
        <text class="no-coupon-text">不使用优惠券</text>
      </view>
      <view class="check-icon">{{!selectedCouponId ? '✓' : ''}}</view>
    </view>

    <!-- 优惠券列表 -->
    <view 
      class="coupon-item {{item.available ? '' : 'disabled'}} {{selectedCouponId === item._id ? 'selected' : ''}}" 
      wx:for="{{coupons}}" 
      wx:key="_id"
      bindtap="onSelectCoupon"
      data-id="{{item._id}}"
      data-available="{{item.available}}"
    >
      <view class="coupon-left">
        <view class="coupon-value">
          <text class="symbol">¥</text>
          <text class="amount">{{item.formattedValue}}</text>
          <text wx:if="{{item.couponInfo.type === 2}}" class="unit">折</text>
        </view>
        <text class="coupon-condition">满{{item.formattedMinAmount}}元可用</text>
      </view>
      <view class="coupon-right">
        <text class="coupon-name">{{item.couponInfo.name}}</text>
        <text class="coupon-time">有效期至 {{item.couponInfo.validTo}}</text>
        <text wx:if="{{!item.available}}" class="unavailable-reason">{{item.reason}}</text>
      </view>
      <view class="check-icon">{{selectedCouponId === item._id ? '✓' : ''}}</view>
    </view>
  </view>

  <!-- 底部确认按钮 -->
  <view class="bottom-bar">
    <button class="confirm-btn" bindtap="onConfirm">确定</button>
  </view>
</view>
