<!-- 支付页面 -->
<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:else class="content">
    <!-- 支付金额 -->
    <view class="amount-section">
      <view class="amount-label">支付金额</view>
      <view class="amount-value">¥{{orderInfo.formattedPayAmount}}</view>
    </view>

    <!-- 订单信息 -->
    <view class="order-section">
      <view class="section-title">订单信息</view>
      
      <view class="info-row">
        <text class="info-label">订单号</text>
        <text class="info-value">{{orderNo}}</text>
      </view>

      <view class="info-row">
        <text class="info-label">商品数量</text>
        <text class="info-value">{{orderInfo.items.length}} 件</text>
      </view>

      <view class="info-row">
        <text class="info-label">收货人</text>
        <text class="info-value">{{orderInfo.address.name}} {{orderInfo.address.phone}}</text>
      </view>

      <view class="info-row">
        <text class="info-label">收货地址</text>
        <text class="info-value address">
          {{orderInfo.address.province}} {{orderInfo.address.city}} {{orderInfo.address.district}} {{orderInfo.address.detail}}
        </text>
      </view>
    </view>

    <!-- 商品列表 -->
    <view class="goods-section">
      <view class="section-title">商品清单</view>
      <view class="goods-list">
        <view class="goods-item" wx:for="{{orderInfo.items}}" wx:key="index">
          <image class="goods-image" src="{{item.productImage}}" mode="aspectFill"></image>
          <view class="goods-info">
            <text class="goods-name">{{item.productName}}</text>
            <text class="goods-spec">{{item.specText}}</text>
            <view class="goods-price-quantity">
              <text class="goods-price">¥{{item.formattedPrice}}</text>
              <text class="goods-quantity">x{{item.quantity}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 支付方式 -->
    <view class="payment-method-section">
      <view class="section-title">支付方式</view>
      <view class="method-item selected">
        <image class="method-icon" src="/images/icons/wechat-pay.png" mode="aspectFit"></image>
        <text class="method-name">微信支付</text>
        <text class="method-check">✓</text>
      </view>
    </view>

    <!-- 支付按钮 -->
    <view class="button-group">
      <button class="cancel-button" bindtap="onCancel">取消支付</button>
      <button class="pay-button" bindtap="onPay" loading="{{paying}}" disabled="{{paying}}">
        {{paying ? '支付中...' : '立即支付'}}
      </button>
    </view>
  </view>
</view>
