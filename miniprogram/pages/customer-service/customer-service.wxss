.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F7F4F0;
}

.messages-container {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

.message-item {
  display: flex;
  margin-bottom: 30rpx;
}

.user-message {
  flex-direction: row-reverse;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.message-content {
  max-width: 500rpx;
  margin: 0 20rpx;
}

.user-message .message-content {
  display: flex;
  justify-content: flex-end;
}

.text-content {
  padding: 20rpx;
  background-color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-wrap: break-word;
}

.user-message .text-content {
  background-color: #95EC69;
}

.image-content {
  max-width: 100%;
  border-radius: 8rpx;
}

.faq-section {
  padding: 40rpx 20rpx;
}

.faq-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  text-align: center;
}

.faq-list {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.faq-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-question {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fff;
  border-top: 1rpx solid #e0e0e0;
}

.message-input {
  flex: 1;
  height: 70rpx;
  padding: 0 20rpx;
  background-color: #F7F4F0;
  border-radius: 35rpx;
  font-size: 28rpx;
}

.actions {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.action-btn {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
}

.icon {
  font-size: 48rpx;
}

.send-btn {
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 30rpx;
  background: linear-gradient(135deg, #5B3A29 0%, #8B6914 100%);
  color: #fff;
  border-radius: 35rpx;
  font-size: 28rpx;
  border: none;
}

.send-btn[disabled] {
  opacity: 0.5;
}
