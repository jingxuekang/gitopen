/* pages/product/product.wxss */
.product-page {
  min-height: 100vh;
  padding-bottom: 140rpx;
  background: #560A0C;
}

.top-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  background: rgba(86, 10, 12, 0.95);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.nav-left {
  width: 90rpx;
}

.nav-center {
  flex: 1;
  display: flex;
  justify-content: center;
}

.nav-right {
  width: 170rpx;
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
}

.back-btn,
.share-btn,
.cart-btn {
  font-size: 32rpx;
  color: #F8E9D5;
}

.search-bar {
  display: flex;
  align-items: center;
  width: 100%;
  max-width: 360rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
}

.search-icon {
  margin-right: 8rpx;
  font-size: 22rpx;
  color: #F8E9D5;
}

.search-placeholder {
  font-size: 22rpx;
  color: #F8E9D5;
}

.hero-wrap {
  margin: 100rpx 18rpx 16rpx;
  padding: 24rpx 16rpx 16rpx;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #7B0E11 0%, #620A0C 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.hero-main {
  display: flex;
  gap: 14rpx;
}

.hero-left {
  flex: 1;
  min-width: 0;
}

.hero-title {
  display: block;
  margin-bottom: 22rpx;
  font-size: 62rpx;
  font-weight: 700;
  color: #F9E7D3;
  line-height: 1.12;
}

.hero-meta-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.hero-meta-item {
  box-sizing: border-box;
  width: 50%;
  padding: 0 8rpx;
  margin-bottom: 14rpx;
  font-size: 28rpx;
  color: #F9E7D3;
  line-height: 1.35;
  white-space: nowrap;
}

.hero-meta-label {
  font-weight: 600;
}

.hero-meta-value {
  margin-left: 4rpx;
}

.hero-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 40rpx;
  color: #F9E7D3;
  line-height: 1.58;
  text-align: justify;
}

.hero-right {
  width: 232rpx;
  flex-shrink: 0;
  padding: 14rpx;
  border-radius: 16rpx;
  background: #F8F3EB;
}

.pack-image {
  width: 100%;
  height: 300rpx;
  margin-bottom: 14rpx;
}

.weight-chip {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 10rpx;
  padding: 8rpx 10rpx;
  border-radius: 999rpx;
  background: #0D6B5A;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
}

.jin-price {
  display: block;
  font-size: 38rpx;
  color: #2E2E2E;
  text-align: center;
  line-height: 1.3;
}

.hero-gallery {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
}

.hero-gallery-item {
  flex: 1;
  height: 220rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #FFFFFF;
}

.hero-gallery-image {
  width: 100%;
  height: 100%;
}

.card {
  margin: 0 18rpx 14rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #FFFFFF;
}

.product-info {
  margin-top: 2rpx;
}

.price-section {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.price-main {
  display: flex;
  align-items: baseline;
  flex: 1;
  color: #D0342C;
}

.price-symbol {
  font-size: 26rpx;
  margin-right: 4rpx;
  font-weight: 700;
}

.price-integer {
  font-size: 48rpx;
  font-weight: 700;
}

.price-unit {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #7C5C48;
}

.price-original {
  font-size: 26rpx;
  color: #9A9A9A;
  text-decoration: line-through;
}

.price-tag .tag {
  background: #F8F3E8;
  color: #7B5227;
  border: 1rpx solid #EAD7BA;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
}

.sales-info {
  display: flex;
  gap: 30rpx;
  font-size: 24rpx;
  color: #8A8A8A;
}

.stock-status-bar {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
}

.stock-status-bar.out_of_stock {
  background: #FFEAEA;
  border: 1rpx solid #E46464;
}

.stock-status-bar.out_of_stock .status-text {
  color: #C33939;
}

.stock-status-bar.low_stock {
  background: #FFF4E3;
  border: 1rpx solid #EDA34C;
}

.stock-status-bar.low_stock .status-text {
  color: #C97A1B;
}

.spec-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.spec-label {
  font-size: 28rpx;
  color: #212121;
  font-weight: 600;
}

.spec-value {
  flex: 1;
  margin: 0 16rpx;
  text-align: right;
  font-size: 26rpx;
  color: #707070;
}

.spec-arrow {
  font-size: 30rpx;
  color: #999999;
}

.product-description {
  margin-bottom: 20rpx;
}

.desc-title {
  margin-bottom: 14rpx;
  font-size: 30rpx;
  color: #2E2E2E;
  font-weight: 700;
}

.desc-content {
  font-size: 26rpx;
  color: #5A5A5A;
  line-height: 1.8;
  text-align: justify;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 18rpx calc(14rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #EFEFEF;
}

.bar-left {
  display: flex;
  gap: 20rpx;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 56rpx;
  font-size: 20rpx;
  color: #666666;
}

.bar-icon {
  margin-bottom: 3rpx;
  font-size: 30rpx;
}

.bar-right {
  display: flex;
  gap: 12rpx;
  flex: 1;
  max-width: 430rpx;
}

.btn-cart,
.btn-buy {
  flex: 1;
  min-height: 76rpx;
  line-height: 76rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 27rpx;
  font-weight: 600;
}

.btn-cart::after,
.btn-buy::after {
  border: none;
}

.btn-cart[disabled],
.btn-buy[disabled] {
  background: #D0D0D0 !important;
  color: #FFFFFF !important;
}

.btn-cart {
  color: #5A3B00;
  background: linear-gradient(135deg, #FFE39A 0%, #FFC94A 100%);
}

.btn-buy {
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF8A3D 0%, #FF5A00 100%);
}

.spec-modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
}

.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.52);
}

.modal-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 80vh;
  padding: 34rpx 24rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: #FFFFFF;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  color: #2A2A2A;
  font-weight: 700;
}

.close-icon {
  font-size: 36rpx;
  color: #999999;
}

.sku-list {
  max-height: 52vh;
  overflow-y: auto;
}

.sku-item {
  margin-bottom: 14rpx;
  padding: 22rpx;
  border-radius: 12rpx;
  border: 2rpx solid #ECECEC;
  background: #FFFFFF;
}

.sku-item.active {
  border-color: #B1181A;
  background: #FFF4F2;
}

.sku-item.disabled {
  opacity: 0.55;
}

.sku-price {
  margin-left: 14rpx;
  color: #D0342C;
  font-weight: 700;
}

.sku-stock {
  margin-left: 14rpx;
  font-size: 24rpx;
  color: #9A9A9A;
}

.sku-stock.out-of-stock {
  color: #D0342C;
}

.confirm-btn {
  width: 100%;
  margin-top: 20rpx;
  padding: 22rpx 0;
  border: none;
  border-radius: 999rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  background: linear-gradient(135deg, #B1181A 0%, #820F12 100%);
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #FFFFFF;
  font-size: 28rpx;
}
