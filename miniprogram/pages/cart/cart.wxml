<view class="cart-container">
  <!-- 空购物车状态 -->
  <view wx:if="{{items.length === 0}}" class="empty-cart">
    <view class="empty-icon">🛒</view>
    <text class="empty-text">购物车空空如也</text>
    <button class="go-shopping-btn" bindtap="goShopping">去逛逛</button>
  </view>

  <!-- 购物车商品列表 -->
  <view wx:else class="cart-content">
    <!-- 商品列表 -->
    <view class="cart-list">
      <view 
        wx:for="{{items}}" 
        wx:key="_id" 
        class="cart-item {{item.available ? '' : 'unavailable'}}"
      >
        <!-- 选择框 -->
        <view class="item-checkbox" bindtap="toggleSelect" data-id="{{item._id}}">
          <icon 
            type="{{item.selected ? 'success' : 'circle'}}" 
            size="20" 
            color="{{item.selected ? '#5B3A29' : '#ccc'}}"
          />
        </view>

        <!-- 商品信息 -->
        <view class="item-content">
          <image class="item-image" src="{{item.productImage}}" mode="aspectFill"></image>
          
          <view class="item-info">
            <view class="item-name">{{item.productName}}</view>
            <view class="item-spec">{{item.specText}}</view>
            
            <!-- 库存不足标记 -->
            <view wx:if="{{!item.available}}" class="stock-warning">
              <text class="warning-text">库存不足</text>
            </view>
            
            <view class="item-bottom">
              <view class="item-price">¥{{item.price / 100}}</view>
              
              <!-- 数量控制器 -->
              <view class="quantity-control">
                <view 
                  class="quantity-btn {{item.quantity <= 1 ? 'disabled' : ''}}" 
                  bindtap="decreaseQuantity" 
                  data-id="{{item._id}}"
                  data-quantity="{{item.quantity}}"
                >-</view>
                <input 
                  class="quantity-input" 
                  type="number" 
                  value="{{item.quantity}}" 
                  disabled
                />
                <view 
                  class="quantity-btn {{item.quantity >= item.stock ? 'disabled' : ''}}" 
                  bindtap="increaseQuantity" 
                  data-id="{{item._id}}"
                  data-quantity="{{item.quantity}}"
                  data-stock="{{item.stock}}"
                >+</view>
              </view>
            </view>
          </view>
        </view>

        <!-- 删除按钮（滑动显示） -->
        <view class="item-delete" bindtap="deleteItem" data-id="{{item._id}}">
          删除
        </view>
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="cart-footer">
      <view class="footer-left">
        <!-- 全选 -->
        <view class="select-all" bindtap="toggleSelectAll">
          <icon 
            type="{{allSelected ? 'success' : 'circle'}}" 
            size="20" 
            color="{{allSelected ? '#5B3A29' : '#ccc'}}"
          />
          <text class="select-all-text">全选</text>
        </view>

        <!-- 批量删除 -->
        <view class="batch-delete" bindtap="batchDelete">
          <text>删除</text>
        </view>
      </view>

      <view class="footer-right">
        <view class="total-info">
          <text class="total-label">合计：</text>
          <text class="total-price">¥{{totalPrice / 100}}</text>
        </view>
        <button 
          class="checkout-btn {{selectedCount === 0 || hasUnavailable ? 'disabled' : ''}}" 
          bindtap="checkout"
        >
          结算({{selectedCount}})
        </button>
      </view>
    </view>
  </view>
</view>
