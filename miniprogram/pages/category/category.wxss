/* pages/category/category.wxss */
.category-page {
  display: flex;
  height: 100vh;
  background-color: #F7F4F0;
}

/* 分类侧边栏 */
.category-sidebar {
  width: 180rpx;
  background: linear-gradient(180deg, #FAF8F5 0%, #F2EDE7 100%);
  z-index: 10;
}

.category-item {
  padding: 44rpx 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8C7B6B;
  position: relative;
  transition: all 0.2s;
  letter-spacing: 2rpx;
}

.category-item.active {
  background: linear-gradient(135deg, #5B3A29 0%, #8B6914 100%);
  color: #FFF8E7;
  font-weight: bold;
  letter-spacing: 4rpx;
}

/* 右侧内容区 */
.content-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 筛选区域 */
.filter-area {
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #E8E0D8;
  max-height: 40vh;
  overflow-y: auto;
  z-index: 100;
  position: relative;
}

.filter-group {
  border-bottom: 1rpx solid #F0EBE5;
  z-index: 10;
  position: relative;
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: linear-gradient(180deg, #FDFBF8 0%, #F8F4EF 100%);
}

.filter-title-row {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.filter-name {
  font-size: 28rpx;
  color: #5B3A29;
  font-weight: bold;
  flex-shrink: 0;
}

.filter-selected-tag {
  font-size: 22rpx;
  color: #8B6914;
  background: linear-gradient(135deg, #FFF8E7 0%, #F5ECD3 100%);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: normal;
  border: 1rpx solid #E8D5A3;
}

.filter-icon {
  font-size: 20rpx;
  color: #B8A898;
  transition: transform 0.3s;
}

.filter-icon.expanded {
  transform: rotate(180deg);
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease, padding 0.3s ease;
}

.filter-options.show {
  max-height: 1000rpx;
  padding: 20rpx 20rpx 10rpx;
}

.filter-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  margin: 0 10rpx 10rpx 0;
  background-color: #FDFBF8;
  border: 2rpx solid #E8E0D8;
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #8C7B6B;
  transition: all 0.2s;
}

.filter-option-icon {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1rpx solid rgba(232, 224, 216, 0.9);
}

.filter-option.active {
  background: linear-gradient(135deg, #5B3A29 0%, #8B6914 100%);
  color: #FFF8E7;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(91, 58, 41, 0.25);
}

/* 商品列表 */
.product-list {
  flex: 1;
  height: 0;
  z-index: 1;
  position: relative;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
}

.product-item {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(91, 58, 41, 0.08);
  transition: all 0.3s;
}

.product-item:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 24rpx rgba(91, 58, 41, 0.15);
}

.product-image {
  width: 100%;
  height: 260rpx;
  background-color: #F7F4F0;
}

.product-info {
  padding: 20rpx;
}

.product-name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 26rpx;
  color: #3D2B1F;
  line-height: 1.4;
  height: 72rpx;
  margin-bottom: 10rpx;
}

.product-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-price {
  display: flex;
  align-items: baseline;
  color: #B5702E;
}

.price-symbol {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.price-integer {
  font-size: 30rpx;
  font-weight: bold;
}

.product-sales {
  font-size: 22rpx;
  color: #B8A898;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx 0;
  color: #B8A898;
  font-size: 28rpx;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #B8A898;
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-state text {
  display: block;
  color: #B8A898;
  font-size: 28rpx;
}

/* 会员价格样式 */
.member-price-wrapper {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.member-price {
  display: flex;
  align-items: baseline;
  color: #8B6914;
  margin-bottom: 4rpx;
}

.member-tag {
  background: linear-gradient(135deg, #8B6914 0%, #D4AF37 100%);
  color: #FFFFFF;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
  font-weight: bold;
}

.member-price .price-symbol {
  font-size: 18rpx;
  margin-right: 2rpx;
}

.member-price .price-integer {
  font-size: 26rpx;
  font-weight: bold;
}

.member-price-wrapper .original-price {
  font-size: 20rpx;
  color: #B8A898;
  text-decoration: line-through;
}
