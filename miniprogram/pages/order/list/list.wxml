<!-- 订单列表页面 -->
<view class="container">
  <!-- Tab 栏 -->
  <view class="tabs">
    <view 
      class="tab-item {{currentTab === item.key ? 'active' : ''}}" 
      wx:for="{{tabs}}" 
      wx:key="key"
      bindtap="onTabChange"
      data-status="{{item.key}}"
    >
      <text>{{item.name}}</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list">
    <view class="order-item" wx:for="{{orders}}" wx:key="_id" bindtap="onViewOrder" data-id="{{item._id}}">
      <!-- 订单头部 -->
      <view class="order-header">
        <text class="order-no">订单号：{{item.orderNo}}</text>
        <text class="order-status {{item.status === 4 ? 'cancelled' : ''}}">
          {{item.status === 0 ? '待付款' : item.status === 1 ? '待发货' : item.status === 2 ? '待收货' : item.status === 3 ? '已完成' : '已取消'}}
        </text>
      </view>

      <!-- 商品列表 -->
      <view class="goods-list">
        <view class="goods-item" wx:for="{{item.items}}" wx:key="index" wx:for-item="goods">
          <image class="goods-image" src="{{goods.productImage}}" mode="aspectFill"></image>
          <view class="goods-info">
            <text class="goods-name">{{goods.productName}}</text>
            <text class="goods-spec">{{goods.specText}}</text>
            <view class="goods-price-quantity">
              <text class="goods-price">¥{{goods.formattedPrice}}</text>
              <text class="goods-quantity">x{{goods.quantity}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 订单金额 -->
      <view class="order-amount">
        <text class="amount-label">实付：</text>
        <text class="amount-value">¥{{item.formattedPayAmount}}</text>
      </view>

      <!-- 操作按钮 -->
      <view class="order-actions" catchtap="stopPropagation">
        <!-- 待付款 -->
        <block wx:if="{{item.status === 0}}">
          <button class="action-btn cancel" bindtap="onCancel" data-id="{{item._id}}">取消订单</button>
          <button class="action-btn primary" bindtap="onPay" data-id="{{item._id}}">去支付</button>
        </block>

        <!-- 待发货 -->
        <block wx:if="{{item.status === 1}}">
          <button class="action-btn" bindtap="onViewOrder" data-id="{{item._id}}">查看详情</button>
        </block>

        <!-- 待收货 -->
        <block wx:if="{{item.status === 2}}">
          <button class="action-btn" bindtap="onViewOrder" data-id="{{item._id}}">查看物流</button>
          <button class="action-btn primary" bindtap="onConfirmReceipt" data-id="{{item._id}}">确认收货</button>
        </block>

        <!-- 已完成 -->
        <block wx:if="{{item.status === 3}}">
          <button class="action-btn" bindtap="onBuyAgain" data-id="{{item._id}}">再次购买</button>
          <button class="action-btn primary" bindtap="onReview" data-id="{{item._id}}">评价</button>
        </block>

        <!-- 已取消 -->
        <block wx:if="{{item.status === 4}}">
          <button class="action-btn" bindtap="onBuyAgain" data-id="{{item._id}}">再次购买</button>
        </block>
      </view>
    </view>

    <!-- 加载状态 -->
    <view wx:if="{{loading && !refreshing}}" class="loading">
      <text>加载中...</text>
    </view>

    <!-- 没有更多 -->
    <view wx:if="{{!loading && !hasMore && orders.length > 0}}" class="no-more">
      <text>没有更多订单了</text>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{!loading && orders.length === 0}}" class="empty">
      <image class="empty-icon" src="/images/empty/order.png" mode="aspectFit"></image>
      <text class="empty-text">暂无订单</text>
    </view>
  </view>
</view>
