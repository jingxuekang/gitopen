<!-- 订单详情页面 -->
<view class="container">
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:else>
    <!-- 订单状态 -->
    <view class="status-section">
      <view class="status-icon">
        <text wx:if="{{order.status === 0}}">⏰</text>
        <text wx:elif="{{order.status === 1}}">📦</text>
        <text wx:elif="{{order.status === 2}}">🚚</text>
        <text wx:elif="{{order.status === 3}}">✅</text>
        <text wx:else>❌</text>
      </view>
      <text class="status-text">
        {{order.status === 0 ? '等待买家付款' : order.status === 1 ? '等待商家发货' : order.status === 2 ? '商品运输中' : order.status === 3 ? '交易完成' : '订单已取消'}}
      </text>
      <view wx:if="{{order.status === 2}}" class="logistics-link" bindtap="onViewLogistics">
        <text>查看物流</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 收货地址 -->
    <view class="address-section">
      <view class="section-title">
        <text class="icon">📍</text>
        <text>收货信息</text>
      </view>
      <view class="address-info">
        <view class="name-phone">
          <text class="name">{{order.address.name}}</text>
          <text class="phone">{{order.address.phone}}</text>
        </view>
        <view class="address-detail">
          {{order.address.province}} {{order.address.city}} {{order.address.district}} {{order.address.detail}}
        </view>
      </view>
    </view>

    <!-- 商品信息 -->
    <view class="goods-section">
      <view class="section-title">
        <text class="icon">🛍️</text>
        <text>商品信息</text>
      </view>
      <view class="goods-list">
        <view class="goods-item" wx:for="{{order.items}}" wx:key="index">
          <image class="goods-image" src="{{item.productImage}}" mode="aspectFill"></image>
          <view class="goods-info">
            <text class="goods-name">{{item.productName}}</text>
            <text class="goods-spec">{{item.specText}}</text>
            <view class="goods-price-quantity">
              <text class="goods-price">¥{{item.priceText}}</text>
              <text class="goods-quantity">x{{item.quantity}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 订单信息 -->
    <view class="order-info-section">
      <view class="section-title">
        <text class="icon">📋</text>
        <text>订单信息</text>
      </view>
      <view class="info-list">
        <view class="info-item">
          <text class="label">订单号</text>
          <view class="value-with-copy">
            <text class="value">{{order.orderNo}}</text>
            <text class="copy-btn" bindtap="onCopyOrderNo">复制</text>
          </view>
        </view>
        <view class="info-item">
          <text class="label">下单时间</text>
          <text class="value">{{order.createdAt}}</text>
        </view>
        <view wx:if="{{order.paymentTime}}" class="info-item">
          <text class="label">支付时间</text>
          <text class="value">{{order.paymentTime}}</text>
        </view>
        <view wx:if="{{order.deliveryTime}}" class="info-item">
          <text class="label">发货时间</text>
          <text class="value">{{order.deliveryTime}}</text>
        </view>
        <view wx:if="{{order.receiveTime}}" class="info-item">
          <text class="label">收货时间</text>
          <text class="value">{{order.receiveTime}}</text>
        </view>
        <view wx:if="{{order.remark}}" class="info-item">
          <text class="label">订单备注</text>
          <text class="value">{{order.remark}}</text>
        </view>
      </view>
    </view>

    <!-- 价格明细 -->
    <view class="price-section">
      <view class="price-row">
        <text class="label">商品总价</text>
        <text class="value">¥{{order.totalAmountText}}</text>
      </view>
      <view wx:if="{{order.discountAmount > 0}}" class="price-row">
        <text class="label">优惠</text>
        <text class="value discount">-¥{{order.discountAmountText}}</text>
      </view>
      <view class="price-row total">
        <text class="label">实付金额</text>
        <text class="value">¥{{order.payAmountText}}</text>
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="bottom-bar">
      <button class="service-btn" bindtap="onContactService">联系客服</button>
      <view class="action-buttons">
        <button wx:if="{{order.status === 0}}" class="action-btn cancel" bindtap="onCancel">取消订单</button>
        <button wx:if="{{order.status === 0}}" class="action-btn primary" bindtap="onPay">去支付</button>
        <button wx:if="{{order.status === 2}}" class="action-btn primary" bindtap="onConfirmReceipt">确认收货</button>
        <button wx:if="{{order.status === 3}}" class="action-btn primary" bindtap="onReview">评价</button>
      </view>
    </view>
  </view>
</view>

<!-- 物流信息弹窗 -->
<view wx:if="{{logistics}}" class="logistics-modal" bindtap="onCloseLogistics">
  <view class="logistics-content" catchtap="onStopPropagation">
    <view class="modal-header">
      <text class="modal-title">物流信息</text>
      <text class="close-btn" bindtap="onCloseLogistics">×</text>
    </view>
    <view class="logistics-info">
      <view class="logistics-header">
        <text class="company">{{logistics.company}}</text>
        <text class="tracking-no">{{logistics.trackingNo}}</text>
      </view>
      <view wx:if="{{logistics.traces && logistics.traces.length > 0}}" class="logistics-timeline">
        <view class="timeline-item" wx:for="{{logistics.traces}}" wx:key="index">
          <view class="timeline-dot {{index === 0 ? 'active' : ''}}"></view>
          <view class="timeline-content">
            <text class="timeline-time">{{item.ftime}}</text>
            <text class="timeline-text">{{item.context}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="no-logistics">
        <text>{{logistics.message || '暂无物流轨迹信息'}}</text>
      </view>
    </view>
  </view>
</view>


