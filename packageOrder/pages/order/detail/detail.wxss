/* pages/order/detail/detail.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #F5EBD9 0%, #F8F4EC 100%);
  padding: 0;
  padding-bottom: calc(118rpx + env(safe-area-inset-bottom));
}

.loading {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8E7D67;
  font-size: 26rpx;
}

.status-section {
  margin: 16rpx 20rpx 0;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #7F6039 0%, #5F462B 100%);
  color: #FFF8EA;
  padding: 40rpx 26rpx;
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(88, 63, 34, 0.22);
}

.status-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.status-badge {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-badge.pending { background: rgba(255, 205, 112, 0.2); }
.status-badge.paid { background: rgba(190, 170, 130, 0.2); }
.status-badge.shipping { background: rgba(130, 226, 182, 0.2); }
.status-badge.done { background: rgba(186, 232, 136, 0.25); }
.status-badge.cancel { background: rgba(253, 150, 150, 0.2); }

/* 待付款 - 钱包 */
.si-wallet { position: relative; width: 40rpx; height: 32rpx; }
.si-wallet-body {
  width: 40rpx; height: 28rpx;
  border: 3rpx solid #FFF8EA;
  border-radius: 6rpx;
  position: absolute; bottom: 0;
}
.si-wallet-flap {
  position: absolute; top: 0; left: 8rpx;
  width: 24rpx; height: 10rpx;
  border: 3rpx solid #FFF8EA;
  border-radius: 6rpx 6rpx 0 0;
  border-bottom: none;
}
.si-wallet-clasp {
  position: absolute; right: 4rpx; top: 50%;
  width: 8rpx; height: 8rpx;
  border-radius: 50%;
  background: #FFF8EA;
}

/* 待发货 - 包裹 */
.si-package { position: relative; width: 42rpx; height: 34rpx; }
.si-pkg-base {
  position: absolute;
  left: 2rpx;
  bottom: 0;
  width: 38rpx;
  height: 20rpx;
  border: 3rpx solid #FFF8EA;
  border-radius: 4rpx;
}
.si-pkg-top-left,
.si-pkg-top-right {
  position: absolute;
  top: 2rpx;
  width: 16rpx;
  height: 10rpx;
  border: 3rpx solid #FFF8EA;
  border-bottom: none;
}
.si-pkg-top-left {
  left: 2rpx;
  border-radius: 4rpx 0 0 0;
  transform: skewY(-10deg);
}
.si-pkg-top-right {
  right: 2rpx;
  border-radius: 0 4rpx 0 0;
  transform: skewY(10deg);
}
.si-pkg-ribbon-v {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: 2rpx;
  width: 3rpx;
  height: 30rpx;
  background: #FFF8EA;
  border-radius: 2rpx;
}
.si-pkg-ribbon-h {
  position: absolute;
  left: 2rpx;
  top: 15rpx;
  width: 38rpx;
  height: 3rpx;
  background: #FFF8EA;
  border-radius: 2rpx;
}

/* 运输中 - 卡车 */
.si-truck { position: relative; width: 44rpx; height: 32rpx; }
.si-truck-body {
  position: absolute; left: 0; bottom: 8rpx;
  width: 28rpx; height: 18rpx;
  border: 3rpx solid #FFF8EA;
  border-radius: 3rpx;
}
.si-truck-cabin {
  position: absolute; right: 0; bottom: 8rpx;
  width: 16rpx; height: 14rpx;
  border: 3rpx solid #FFF8EA;
  border-radius: 0 4rpx 4rpx 0;
  border-left: none;
}
.si-truck-wheel {
  position: absolute; bottom: 0;
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
  background: #FFF8EA;
}
.si-truck-wheel.w1 { left: 6rpx; }
.si-truck-wheel.w2 { right: 4rpx; }

/* 已完成 - 勾选 */
.si-check { position: relative; width: 36rpx; height: 36rpx; }
.si-check-circle {
  width: 36rpx; height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #FFF8EA;
}
.si-check-mark {
  position: absolute;
  left: 9rpx; top: 10rpx;
  width: 16rpx; height: 10rpx;
  border-left: 3rpx solid #FFF8EA;
  border-bottom: 3rpx solid #FFF8EA;
  transform: rotate(-45deg);
}

/* 已取消 - X */
.si-close { position: relative; width: 36rpx; height: 36rpx; }
.si-close-line {
  position: absolute;
  top: 50%; left: 50%;
  width: 24rpx; height: 3rpx;
  background: #FFF8EA;
  border-radius: 2rpx;
}
.si-close-line.l1 { transform: translate(-50%, -50%) rotate(45deg); }
.si-close-line.l2 { transform: translate(-50%, -50%) rotate(-45deg); }

.status-text {
  font-size: 31rpx;
  font-weight: 600;
}

.logistics-link {
  margin-top: 18rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  font-size: 24rpx;
}

.arrow {
  margin-left: 8rpx;
  font-size: 24rpx;
}

.address-section,
.goods-section,
.order-info-section,
.price-section {
  margin: 16rpx 20rpx 0;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 10rpx 28rpx rgba(77, 54, 30, 0.06);
  padding: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #2F2A22;
}

/* section 图标 */
.sec-icon {
  margin-right: 12rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
}

.sec-icon.icon-address { background: linear-gradient(135deg, #6B9A54, #8AB870); }
.sec-icon.icon-goods { background: linear-gradient(135deg, #8D6439, #A67B4E); }
.sec-icon.icon-order { background: linear-gradient(135deg, #6C7FB0, #8494C4); }

/* 地址定位针 */
.sec-pin {
  width: 12rpx; height: 16rpx;
  border: 2rpx solid #fff;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}
.sec-pin-dot {
  position: absolute;
  top: 12rpx; left: 50%;
  transform: translateX(-50%);
  width: 4rpx; height: 4rpx;
  border-radius: 50%;
  background: #fff;
}

/* 商品箱子（3D） */
.sec-box {
  position: relative;
  width: 20rpx;
  height: 18rpx;
}

.sec-box-top {
  position: absolute;
  top: 0;
  left: 2rpx;
  width: 16rpx;
  height: 6rpx;
  border: 2rpx solid #fff;
  border-bottom: none;
  border-radius: 2rpx 2rpx 0 0;
}

.sec-box-front {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 20rpx;
  height: 12rpx;
  border: 2rpx solid #fff;
  border-radius: 2rpx;
}

.sec-box-ribbon {
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 2rpx;
  height: 14rpx;
  background: #fff;
  border-radius: 1rpx;
}

/* 订单文档 */
.sec-doc {
  width: 16rpx; height: 20rpx;
  border: 2rpx solid #fff;
  border-radius: 2rpx;
}
.sec-doc-line {
  position: absolute;
  height: 2rpx;
  background: #fff;
  border-radius: 1rpx;
}
.sec-doc-line.l1 { width: 10rpx; top: 15rpx; left: 50%; transform: translateX(-50%); }
.sec-doc-line.l2 { width: 8rpx; top: 20rpx; left: 50%; transform: translateX(-50%); }

.address-info,
.goods-list,
.info-list {
  padding-left: 40rpx;
}

.name-phone {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.name {
  font-size: 30rpx;
  color: #2F2A22;
  font-weight: 600;
  margin-right: 16rpx;
}

.phone {
  font-size: 26rpx;
  color: #74695C;
}

.address-detail {
  font-size: 26rpx;
  line-height: 1.65;
  color: #5A5046;
}

.goods-item {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #EFE5D6;
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-image {
  width: 132rpx;
  height: 132rpx;
  border-radius: 14rpx;
  margin-right: 16rpx;
  background: #F7F2E9;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 26rpx;
  color: #2F2A22;
  line-height: 1.45;
}

.goods-spec {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9A8E81;
}

.goods-price-quantity {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.goods-price {
  font-size: 30rpx;
  color: #B5702E;
  font-weight: 700;
}

.goods-quantity {
  font-size: 23rpx;
  color: #8D8174;
}

.info-item {
  min-height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #EFE5D6;
  padding: 8rpx 0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 24rpx;
  color: #918576;
}

.info-item .value {
  max-width: 68%;
  text-align: right;
  font-size: 24rpx;
  color: #3B3228;
  line-height: 1.5;
}

.value-with-copy {
  display: flex;
  align-items: center;
}

.copy-btn {
  margin-left: 10rpx;
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 21rpx;
  border: 1rpx solid #E2C9A5;
  background: #FFF3E0;
  color: #8D6439;
  font-size: 21rpx;
  display: inline-flex;
  align-items: center;
}

.price-row {
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 25rpx;
}

.price-row .label {
  color: #7A6E60;
}

.price-row .value {
  color: #2F2A22;
}

.price-row .value.discount {
  color: #C45A4A;
}

.price-row.total {
  margin-top: 8rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #EFE5D6;
}

.price-row.total .label {
  font-size: 28rpx;
  color: #2F2A22;
  font-weight: 700;
}

.price-row.total .value {
  font-size: 34rpx;
  color: #B5702E;
  font-weight: 700;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));
  background: #FFFCF6;
  border-top: 1rpx solid #E8D9BF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.service-btn {
  min-width: 144rpx;
  max-width: 38%;
  height: 74rpx;
  line-height: 74rpx;
  border-radius: 37rpx;
  border: 1rpx solid #DFCCB0;
  background: #FFF7EA;
  color: #7A5B36;
  font-size: 25rpx;
  padding: 0 20rpx;
}

.service-btn::after {
  border: none;
}

.action-buttons {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  gap: 8rpx;
  flex-wrap: nowrap;
  min-width: 0;
}

.action-btn {
  min-width: 0;
  max-width: none;
  height: 72rpx;
  line-height: 1;
  border-radius: 36rpx;
  font-size: 24rpx;
  font-weight: 600;
  padding: 0 18rpx;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn::after {
  border: none;
}

.action-btn.cancel {
  background: #FFF4F2;
  border: 1rpx solid #E7B0A9;
  color: #B14B43;
}

.action-btn.primary {
  border: none;
  color: #FFFFFF;
  background: linear-gradient(135deg, #83643D 0%, #644A2D 100%);
}

.logistics-modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
}

.logistics-content {
  width: 100%;
  max-height: 74vh;
  border-radius: 24rpx 24rpx 0 0;
  background: #FFFFFF;
  padding: 20rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
}

.modal-header {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #EFE5D6;
  padding-bottom: 10rpx;
}

.modal-title {
  font-size: 30rpx;
  color: #2F2A22;
  font-weight: 700;
}

.close-btn {
  font-size: 40rpx;
  color: #9D9183;
  line-height: 1;
  padding: 4rpx 8rpx;
}

.logistics-info {
  margin-top: 16rpx;
}

.logistics-header {
  margin-bottom: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.company {
  font-size: 27rpx;
  color: #2F2A22;
  font-weight: 600;
}

.tracking-no {
  font-size: 22rpx;
  color: #8D8276;
}

.logistics-timeline {
  margin-top: 8rpx;
}

.timeline-item {
  display: flex;
  padding: 10rpx 0;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  margin-right: 12rpx;
  background: #D5C8B3;
  flex-shrink: 0;
}

.timeline-dot.active {
  background: #8A6640;
}

.timeline-content {
  flex: 1;
}

.timeline-time {
  display: block;
  font-size: 21rpx;
  color: #9C9184;
  margin-bottom: 4rpx;
}

.timeline-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.55;
  color: #4E4438;
}

.no-logistics {
  padding: 34rpx 0;
  text-align: center;
  color: #8E8275;
  font-size: 24rpx;
}
