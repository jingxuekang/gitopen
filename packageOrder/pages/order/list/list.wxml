<!-- 订单列表页面 -->
<view class="container">
  <nav-header title="我的订单" showBack="{{true}}"></nav-header>
  <view class="nav-placeholder"></view>
  <!-- Tab 栏 -->
  <view class="tabs">
    <view 
      class="tab-item {{currentTab === item.key ? 'active' : ''}}" 
      wx:for="{{tabs}}" 
      wx:key="key"
      bindtap="onTabChange"
      data-status="{{item.key}}"
    >
      <text>{{item.name}}</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list">
    <view wx:if="{{loading && orders.length === 0}}" class="loading">
      <skeleton type="order-card" wx:for="{{[1,2,3]}}" wx:key="index"></skeleton>
    </view>

    <order-item
      wx:for="{{orders}}"
      wx:key="_id"
      order="{{item}}"
      bind:tap="onViewOrder"
      bind:pay="onPay"
      bind:cancel="onCancel"
      bind:confirm="onConfirmReceipt"
      bind:review="onReview"
      bind:buyagain="onBuyAgain"
    />

    <!-- 加载状态 -->
    <view wx:if="{{loading && !refreshing && orders.length > 0}}" class="loading">
      <text>加载中...</text>
    </view>

    <!-- 没有更多 -->
    <view wx:if="{{!loading && !hasMore && orders.length > 0}}" class="no-more">
      <text>没有更多订单了</text>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{!loading && orders.length === 0}}" class="empty">
      <image class="empty-icon" src="/images/empty/order.png" mode="aspectFit"></image>
      <text class="empty-text">暂无订单</text>
    </view>
  </view>
</view>
