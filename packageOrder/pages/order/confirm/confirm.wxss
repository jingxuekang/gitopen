/* 订单确认页面样式 */

.container {
  min-height: 100vh;
  background-color: #F7F4F0;
  padding: 20rpx 0 120rpx;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  color: #2f2f2f;
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: var(--color-text-secondary, #7A6B5A);
}

/* 收货地址区域 */
.address-section {
  background-color: #fff;
  border-radius: 20rpx;
  margin: 0 20rpx 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(67, 45, 20, 0.06);
  margin-bottom: 20rpx;
}

.address-card {
  padding: 30rpx;
}

.address-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.icon-location {
  font-size: 36rpx;
  margin-right: 10rpx;
}

.address-title {
  flex: 1;
  font-size: 31rpx;
  font-weight: 600;
  color: #2f2f2f;
}

.icon-arrow {
  font-size: 40rpx;
  color: var(--color-text-secondary, #7A6B5A);
}

.address-info {
  padding-left: 46rpx;
}

.address-name-phone {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2f2f2f;
  margin-right: 20rpx;
}

.phone {
  font-size: 27rpx;
  color: #6a6a6a;
}

.address-detail {
  font-size: 27rpx;
  color: #707070;
  line-height: 1.7;
}

.address-empty {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  color: var(--color-text-secondary, #7A6B5A);
}

.icon-add {
  font-size: 40rpx;
  margin-right: 10rpx;
}

.empty-text {
  flex: 1;
  font-size: 32rpx;
}

/* 商品列表区域 */
.goods-section {
  background-color: #fff;
  border-radius: 20rpx;
  margin: 0 20rpx 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(67, 45, 20, 0.06);
}

.section-title {
  font-size: 31rpx;
  font-weight: 600;
  color: #2f2f2f;
  margin-bottom: 22rpx;
  letter-spacing: 0.5rpx;
}

.goods-list {
  /* 商品列表容器 */
}

.goods-item {
  display: flex;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #EDE5D8;
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  color: #2f2f2f;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.goods-spec {
  font-size: 24rpx;
  color: #8f8f8f;
  margin-top: 12rpx;
  line-height: 1.5;
}

.goods-price-quantity {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.goods-price {
  font-size: 34rpx;
  font-weight: 600;
  color: #B5702E;
}

.goods-quantity {
  font-size: 27rpx;
  color: #8f8f8f;
}

.quantity-control {
  display: flex;
  align-items: center;
}

.qty-stepper {
  height: 54rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #e5dfd5;
  border-radius: 28rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.6);
}

.qty-action {
  width: 58rpx;
  height: 54rpx;
  line-height: 54rpx;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  color: #5B3A29;
  background: #f8f4ec;
}

.qty-action.disabled {
  color: #c7c1b6;
}

.qty-input {
  width: 88rpx;
  height: 54rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #2f2f2f;
  padding: 0;
  border-left: 1rpx solid #eee8dd;
  border-right: 1rpx solid #eee8dd;
  background: #fff;
}

/* 优惠券区域 */
.coupon-section {
  background-color: #fff;
  border-radius: 20rpx;
  margin: 0 20rpx 20rpx;
  padding: 0 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(67, 45, 20, 0.06);
}

.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  padding: 0;
}

.coupon-label {
  font-size: 30rpx;
  color: #2f2f2f;
  font-weight: 500;
  line-height: 100rpx;
}

.coupon-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  height: 100rpx;
}

.coupon-selected {
  font-size: 27rpx;
  color: #B5702E;
  line-height: 100rpx;
}

.coupon-placeholder {
  font-size: 27rpx;
  color: #9a9a9a;
  line-height: 100rpx;
}

.coupon-value .icon-arrow {
  font-size: 30rpx;
  color: #b3b3b3;
  line-height: 100rpx;
}

/* 订单备注区域 */
.remark-section {
  background-color: #fff;
  border-radius: 20rpx;
  margin: 0 20rpx 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(67, 45, 20, 0.06);
}

.remark-label {
  font-size: 30rpx;
  color: #2f2f2f;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.remark-input {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  background-color: #F7F4F0;
  border-radius: 8rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #4a4a4a;
}

/* 价格明细区域 */
.price-section {
  background-color: #fff;
  border-radius: 20rpx;
  margin: 0 20rpx 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(67, 45, 20, 0.06);
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.price-row:last-child {
  margin-bottom: 0;
}

.price-label {
  font-size: 27rpx;
  color: var(--color-text-secondary, #7A6B5A);
}

.price-value {
  font-size: 27rpx;
  color: #2f2f2f;
  font-weight: 500;
}

.price-value.discount {
  color: #B5702E;
}

.price-value.member-discount {
  color: #D4AF37;
}

.member-badge {
  background: linear-gradient(135deg, #D4AF37 0%, #F4D03F 100%);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
  font-weight: bold;
}

/* 底部提交栏 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  border-top: 1rpx solid #EDE5D8;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.submit-price {
  flex: 1;
}

.submit-label {
  font-size: 28rpx;
  color: var(--color-text-secondary, #7A6B5A);
}

.submit-amount {
  font-size: 40rpx;
  font-weight: 600;
  color: #B5702E;
}

.submit-button {
  width: 240rpx;
  height: 84rpx;
  line-height: 84rpx;
  background: linear-gradient(135deg, #5B3A29 0%, #8B6914 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 42rpx;
  border: none;
  padding: 0;
}

.submit-button[disabled] {
  background: #ccc;
  color: #fff;
}
