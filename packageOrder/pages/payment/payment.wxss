/* 支付页面 */

.container {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding: 20rpx 0 40rpx;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: var(--color-text-secondary);
}

.content {
  padding-bottom: 40rpx;
}

/* ===== 支付金额 ===== */
.amount-section {
  background: var(--gradient-brand);
  border-radius: var(--radius-md);
  padding: 48rpx 24rpx;
  text-align: center;
  margin: 0 20rpx 20rpx;
  box-shadow: var(--shadow-lg);
}

.amount-label {
  font-size: var(--font-base);
  color: rgba(255, 248, 231, 0.7);
  margin-bottom: 16rpx;
}

.amount-value {
  font-size: 80rpx;
  font-weight: 700;
  color: #FFF8E7;
  letter-spacing: -2rpx;
}

/* ===== 订单信息 ===== */
.order-section {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin: 0 20rpx 20rpx;
  box-shadow: var(--shadow-md);
}

.section-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 160rpx;
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: var(--font-base);
  color: var(--color-text);
  text-align: right;
}

.info-value.address {
  text-align: right;
  line-height: 1.6;
}

/* ===== 商品列表 ===== */
.goods-section {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin: 0 20rpx 20rpx;
  box-shadow: var(--shadow-md);
}

.goods-item {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  margin-right: 20rpx;
  flex-shrink: 0;
  background: var(--color-bg-secondary);
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: var(--font-base);
  color: var(--color-text);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.goods-spec {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
  margin-top: 8rpx;
}

.goods-price-quantity {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}

.goods-price {
  font-size: var(--font-base);
  color: var(--color-price);
  font-weight: 600;
}

.goods-quantity {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
}

/* ===== 支付方式 ===== */
.payment-method-section {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin: 0 20rpx 24rpx;
  box-shadow: var(--shadow-md);
}

.method-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  transition: all 0.2s;
}

.method-item.selected {
  border-color: var(--color-primary);
  background-color: #FFF8EA;
}

.method-icon {
  width: 56rpx;
  height: 56rpx;
  margin-right: 20rpx;
}

.wechat-icon {
  border-radius: 50%;
  background: #07C160;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.method-name {
  flex: 1;
  font-size: var(--font-md);
  color: var(--color-text);
}

.method-check {
  font-size: 36rpx;
  color: var(--color-primary);
  font-weight: 600;
}

/* ===== 按钮组 ===== */
.button-group {
  display: flex;
  gap: 20rpx;
  padding: 0 20rpx;
}

.cancel-button {
  flex: 1;
  height: 88rpx;
  background-color: var(--color-bg-card);
  color: var(--color-text-secondary);
  font-size: var(--font-md);
  font-weight: 500;
  border: 2rpx solid var(--color-border);
  border-radius: 44rpx;
}

.pay-button {
  flex: 1.2;
  height: 88rpx;
  background: var(--gradient-brand);
  color: #FFF8E7;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(91, 58, 41, 0.25);
}

.cancel-button::after,
.pay-button::after {
  border: none;
}

.pay-button[disabled] {
  background: var(--color-text-disabled);
  box-shadow: none;
}
