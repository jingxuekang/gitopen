/**app.wxss**/

/* ===== 全局设计系统 ===== */
page {
  --color-primary: #5B3A29;
  --color-primary-light: #8B6914;
  --color-gold: #A68523;
  --color-price: #B5702E;
  --color-success: #5B8C5A;
  --color-warning: #C88023;
  --color-danger: #B54A32;

  --color-bg: #F7F4F0;
  --color-bg-card: #FFFFFF;
  --color-bg-secondary: #F5F0E8;
  --color-bg-hover: #FBF8F4;

  --color-text: #3D2B1F;
  --color-text-secondary: #7A6B5A;
  --color-text-hint: #B8A898;
  --color-text-disabled: #D4C5B5;

  --color-border: #EDE5D8;
  --color-divider: #F2ECE3;

  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
  --radius-full: 999rpx;

  --shadow-sm: 0 2rpx 8rpx rgba(67, 45, 20, 0.06);
  --shadow-md: 0 8rpx 24rpx rgba(67, 45, 20, 0.08);
  --shadow-lg: 0 12rpx 36rpx rgba(67, 45, 20, 0.12);
  --shadow-up: 0 -4rpx 20rpx rgba(67, 45, 20, 0.06);

  --font-xs: 22rpx;
  --font-sm: 24rpx;
  --font-base: 28rpx;
  --font-md: 30rpx;
  --font-lg: 34rpx;
  --font-xl: 40rpx;

  --gradient-brand: linear-gradient(135deg, #5B3A29 0%, #8B6914 100%);
  --gradient-gold: linear-gradient(135deg, #8B6914 0%, #A68523 100%);

  background-color: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: var(--font-base);
  line-height: 1.5;
}

/* ===== 全局动画 ===== */
@keyframes pageFadeIn {
  0% { opacity: 0; transform: translateY(12rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes cardFadeUp {
  0% { opacity: 0; transform: translateY(20rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes shimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}

@keyframes modalFadeIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes modalSlideUp {
  0% { transform: translateY(100%); }
  100% { transform: translateY(0); }
}

@keyframes modalFadeOut {
  0% { opacity: 1; }
  100% { opacity: 0; }
}

@keyframes modalSlideDown {
  0% { transform: translateY(0); }
  100% { transform: translateY(100%); }
}

@keyframes pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.7; }
}

/* ===== 全局重置 ===== */
view, text, button, input, textarea, scroll-view, swiper {
  box-sizing: border-box;
}

button {
  border: none;
  background: transparent;
  max-width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: transform 0.18s ease, opacity 0.18s ease;
}

button::after {
  border: none;
}

button:active {
  transform: scale(0.97);
  opacity: 0.9;
}

/* ===== 页面入场动画 ===== */
.container,
.product-page,
.search-page,
.category-page,
.login-page,
.settings-page,
.cart-container {
  animation: pageFadeIn 0.3s ease-out both;
}

/* ===== 卡片入场动画 ===== */
.status-section,
.address-section,
.goods-section,
.order-info-section,
.price-section,
.summary-card,
.meta-card,
.gallery-card,
.taobao-detail-card,
.detail-note-card,
.coupon-item,
.favorite-item,
.suggestion-section,
.empty,
.loading,
.amount-section,
.order-section,
.payment-method-section {
  animation: cardFadeUp 0.35s ease-out both;
}

/* ===== 全局交互反馈 ===== */
.tab-item,
.tabbar-item,
.keyword-item,
.filter-option,
.action-btn,
.go-shopping-btn,
.go-center-btn,
.confirm-btn,
.submit-btn,
.cart-item,
.goods-item,
.faq-item,
.method-item {
  transition: transform 0.18s ease, box-shadow 0.2s ease, opacity 0.18s ease;
}

.tab-item:active,
.keyword-item:active,
.filter-option:active,
.action-btn:active {
  transform: scale(0.97);
  opacity: 0.88;
}

/* ===== 主题卡片 ===== */
.theme-surface {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  animation: cardFadeUp 0.35s ease-out both;
}

.theme-section {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  margin: 0 20rpx 20rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-md);
  animation: cardFadeUp 0.35s ease-out both;
}

.theme-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.4;
}

.theme-subtitle {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

/* ===== 通用按钮 ===== */
.theme-primary-btn,
.btn-primary {
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--gradient-brand);
  color: #FFF8E7;
  font-size: var(--font-md);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(91, 58, 41, 0.25);
}

.theme-outline-btn,
.btn-secondary {
  height: 88rpx;
  border-radius: 44rpx;
  border: 2rpx solid #DCC7A5;
  background: #FFF8EA;
  color: #7A582E;
  font-size: var(--font-base);
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
}

/* ===== 通用卡片 ===== */
.card {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-md);
  animation: cardFadeUp 0.35s ease-out both;
}

/* ===== 价格样式 ===== */
.price {
  color: var(--color-price);
  font-weight: bold;
}

.price-symbol {
  font-size: var(--font-sm);
}

.price-integer {
  font-size: var(--font-xl);
}

.price-decimal {
  font-size: var(--font-base);
}

/* ===== 标签 ===== */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: var(--font-sm);
  margin-right: 10rpx;
}

.tag-primary {
  background: var(--gradient-brand);
  color: #FFF8E7;
}

.tag-secondary {
  background-color: var(--color-bg-secondary);
  color: var(--color-text-secondary);
}

/* ===== 兼容旧类名 ===== */
.primary-color { color: var(--color-primary); }
.secondary-color { color: var(--color-primary-light); }
.accent-color { color: #D4AF37; }
.text-primary { color: var(--color-text); }
.text-secondary { color: var(--color-text-hint); }
.bg-primary { background-color: var(--color-primary); }
.bg-secondary { background-color: var(--color-bg); }

/* ===== 通用容器 ===== */
.container {
  padding: 30rpx;
}

/* ===== 分割线 ===== */
.divider {
  height: 1rpx;
  background-color: var(--color-divider);
  margin: 30rpx 0;
}

/* ===== 空状态 ===== */
.empty-state {
  text-align: center;
  padding: 120rpx 60rpx;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-state text {
  display: block;
  color: var(--color-text-hint);
  font-size: var(--font-base);
}

/* ===== 加载状态 ===== */
.loading {
  text-align: center;
  padding: 40rpx 0;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

/* ===== 骨架屏基础 ===== */
.skeleton-block {
  background: linear-gradient(90deg, #F0EAE0 25%, #F7F2EA 50%, #F0EAE0 75%);
  background-size: 800rpx 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: var(--radius-sm);
}

/* ===== 文字排版 ===== */
.section-title,
.card-title,
.nav-title,
.header-title {
  line-height: 1.35;
  letter-spacing: 0.4rpx;
  font-weight: 700;
}

.status-title,
.status-text,
.empty-text {
  line-height: 1.4;
  letter-spacing: 0.2rpx;
  font-weight: 600;
}

/* ===== 安全区域 ===== */
.safe-area-top {
  padding-top: env(safe-area-inset-top);
}

.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 自定义导航栏占位 ===== */
.nav-placeholder {
  width: 100%;
  height: calc(env(safe-area-inset-top) + 88rpx);
}
