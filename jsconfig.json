{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "*": ["*", "miniprogram/*"]
    },
    "lib": ["ES6"]
  },
  "exclude": [
    "node_modules",
    "dist",
    "cloudfunctions"
  ],
  "include": [
    "miniprogram/**/*"
  ]
}
