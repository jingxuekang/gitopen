.user-page {
  min-height: 100vh;
  background: #F7F4F0;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 沉浸式顶部 */
.user-header {
  background: linear-gradient(150deg, #5B3A29 0%, #8B6914 55%, #A67C1A 100%);
  padding: 0 24rpx 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(60, 36, 10, 0.28);
  margin-bottom: 20rpx;
}

.nav-status-bar {
  width: 100%;
}

.header-nav-row {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFF8E8;
  letter-spacing: 2rpx;
  text-shadow: 0 1rpx 6rpx rgba(60, 36, 10, 0.2);
}

.profile-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 4rpx 0;
}

.profile-left {
  display: flex;
  align-items: center;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: #E8E0D8;
  border: 3rpx solid rgba(255, 220, 120, 0.6);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.18);
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.15);
  border: 3rpx solid rgba(255, 220, 120, 0.6);
}

.avatar-text {
  font-size: 44rpx;
  color: #FFF8E7;
  font-weight: 600;
}

.user-meta {
  margin-left: 24rpx;
}

.name {
  font-size: 38rpx;
  font-weight: 700;
  color: #FFF8E7;
  line-height: 1.3;
  letter-spacing: 1rpx;
}

.user-sub {
  font-size: 24rpx;
  color: rgba(255, 248, 231, 0.65);
  margin-top: 6rpx;
  display: block;
}

.profile-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 248, 231, 0.45);
  background: rgba(255, 255, 255, 0.18);
  box-shadow: inset 0 1rpx 4rpx rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.18s ease, background 0.18s ease;
}

.icon-btn:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.26);
}

.icon {
  font-size: 26rpx;
  color: #FFF8E7;
  font-weight: 600;
}

.chat-icon {
  width: 34rpx;
  height: 26rpx;
  background: transparent;
  border: 2rpx solid rgba(255, 248, 231, 0.95);
  border-radius: 10rpx;
  position: relative;
}

.chat-icon::before {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 8rpx;
  width: 20rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: rgba(255, 248, 231, 0.95);
}

.chat-icon::after {
  content: '';
  position: absolute;
  bottom: -5rpx;
  left: 9rpx;
  width: 8rpx;
  height: 8rpx;
  border-left: 2rpx solid rgba(255, 248, 231, 0.95);
  border-bottom: 2rpx solid rgba(255, 248, 231, 0.95);
  transform: rotate(-42deg);
}

.settings-icon {
  width: 34rpx;
  height: 34rpx;
  background: transparent;
  border: 2rpx solid rgba(255, 248, 231, 0.95);
  border-radius: 50%;
  position: relative;
}

.settings-icon::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 7rpx;
  height: 7rpx;
  background: rgba(255, 248, 231, 0.95);
  border-radius: 50%;
}

.settings-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 22rpx;
  height: 22rpx;
  border: 2rpx dashed rgba(255, 248, 231, 0.95);
  border-radius: 50%;
  box-sizing: border-box;
}

.order-stats {
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(67, 45, 20, 0.06);
}

.stats-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #EDE5D8;
}

.stats-item:last-child {
  border-right: none;
}

.stats-item:active {
  background: #FBF8F4;
}

.stats-count {
  display: block;
  font-size: 34rpx;
  color: #5B3A29;
  font-weight: 600;
}

.stats-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8C7B6B;
}

.function-group {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(67, 45, 20, 0.06);
}

.function-item {
  height: 98rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #EDE5D8;
  box-sizing: border-box;
}

.function-item:active {
  background: #FBF8F4;
}

.item-label {
  font-size: 30rpx;
  color: #5B3A29;
}

.arrow {
  font-size: 40rpx;
  color: #B8A898;
}

.no-border {
  border-bottom: none;
}
