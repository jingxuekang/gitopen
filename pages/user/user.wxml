<!-- pages/user/user.wxml -->
<view class="user-page">
  <!-- 沉浸式顶部区域 -->
  <view class="user-header">
    <view class="nav-status-bar" style="height: {{navBarHeight}}px;"></view>
    <view class="header-nav-row">
      <text class="header-nav-title">个人中心</text>
    </view>
    <!-- 用户信息 -->
    <view class="profile-card" bindtap="onLoginTap">
      <view class="profile-left">
        <view wx:if="{{!(isLogin && userInfo.avatar)}}" class="avatar avatar-fallback">
          <text class="avatar-text">{{avatarText}}</text>
        </view>
        <image wx:else class="avatar" src="{{userInfo.avatar}}" mode="aspectFill"></image>
        <view class="user-meta">
          <text class="name">{{isLogin ? (userInfo.nickname || '微信用户') : '点击登录'}}</text>
          <text class="user-sub">{{isLogin ? '欢迎回来' : '登录后享受更多权益'}}</text>
        </view>
      </view>
      <view class="profile-actions">
        <view class="icon-btn" catchtap="goToMessages">
          <view class="icon chat-icon"></view>
        </view>
        <view class="icon-btn" catchtap="onSettingsTap">
          <view class="icon settings-icon"></view>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{isLogin}}" class="order-stats">
    <view class="stats-item" bindtap="goToOrders" data-status="0">
      <text class="stats-count">{{orderStats.unpaid}}</text>
      <text class="stats-label">待付款</text>
    </view>
    <view class="stats-item" bindtap="goToOrders" data-status="1">
      <text class="stats-count">{{orderStats.unshipped}}</text>
      <text class="stats-label">待发货</text>
    </view>
    <view class="stats-item" bindtap="goToOrders" data-status="2">
      <text class="stats-count">{{orderStats.unreceived}}</text>
      <text class="stats-label">待收货</text>
    </view>
    <view class="stats-item" bindtap="goToOrders" data-status="3">
      <text class="stats-count">{{orderStats.unreviewed}}</text>
      <text class="stats-label">待评价</text>
    </view>
  </view>

  <view class="function-group">
    <view class="function-item" bindtap="goToOrders">
      <text class="item-label">我的订单</text>
      <text class="arrow">›</text>
    </view>
    <view class="function-item" bindtap="goToAddress">
      <text class="item-label">收货地址</text>
      <text class="arrow">›</text>
    </view>
    <view class="function-item" bindtap="goToFavorite">
      <text class="item-label">我的收藏</text>
      <text class="arrow">›</text>
    </view>
    <view class="function-item" bindtap="goToCoupon">
      <text class="item-label">优惠券</text>
      <text class="arrow">›</text>
    </view>
    <view class="function-item no-border" bindtap="goToCustomerService">
      <text class="item-label">在线客服</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <custom-tabbar current="3" />
</view>
