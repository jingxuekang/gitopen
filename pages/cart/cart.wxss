/* 购物车页面 */

.cart-container {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

/* ===== 空状态 ===== */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
}

.empty-illustration {
  margin-bottom: 40rpx;
}

.empty-cup {
  position: relative;
  width: 160rpx;
  height: 140rpx;
}

.cup-body {
  position: absolute;
  bottom: 24rpx;
  left: 30rpx;
  width: 80rpx;
  height: 68rpx;
  border: 4rpx solid var(--color-text-hint);
  border-radius: 4rpx 4rpx 20rpx 20rpx;
  border-top: none;
}

.cup-handle {
  position: absolute;
  bottom: 40rpx;
  right: 24rpx;
  width: 24rpx;
  height: 32rpx;
  border: 4rpx solid var(--color-text-hint);
  border-radius: 0 12rpx 12rpx 0;
  border-left: none;
}

.cup-saucer {
  position: absolute;
  bottom: 10rpx;
  left: 16rpx;
  width: 110rpx;
  height: 8rpx;
  background: var(--color-text-hint);
  border-radius: 4rpx;
  opacity: 0.5;
}

.cup-steam {
  position: absolute;
  width: 4rpx;
  background: var(--color-text-disabled);
  border-radius: 4rpx;
  animation: steam 2s ease-in-out infinite;
}

.cup-steam.s1 {
  left: 50rpx;
  bottom: 95rpx;
  height: 24rpx;
  animation-delay: 0s;
}

.cup-steam.s2 {
  left: 66rpx;
  bottom: 100rpx;
  height: 20rpx;
  animation-delay: 0.5s;
}

.cup-steam.s3 {
  left: 82rpx;
  bottom: 95rpx;
  height: 24rpx;
  animation-delay: 1s;
}

@keyframes steam {
  0%, 100% { opacity: 0.2; transform: translateY(0) scaleY(1); }
  50% { opacity: 0.5; transform: translateY(-12rpx) scaleY(1.3); }
}

.empty-title {
  font-size: var(--font-md);
  color: var(--color-text);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
  margin-bottom: 48rpx;
}

.go-shopping-btn {
  width: 320rpx;
  height: 84rpx;
  background: var(--gradient-brand);
  color: #FFF8E7;
  border-radius: 42rpx;
  font-size: var(--font-base);
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(91, 58, 41, 0.25);
}

.go-shopping-btn::after { border: none; }

/* ===== 骨架屏 ===== */
.skeleton-wrap {
  padding: 20rpx;
}

.skeleton-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
}

.skeleton-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.skeleton-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.skeleton-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
}

.skeleton-line-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

/* ===== 商品列表 ===== */
.cart-content {
  padding-bottom: 20rpx;
}

.cart-list {
  padding: 20rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
  transition: opacity 0.2s;
}

.cart-item:last-child {
  margin-bottom: 0;
}

.cart-item.unavailable {
  opacity: 0.65;
}

/* ===== 自定义复选框 ===== */
.checkbox-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-text-disabled);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.checkbox-icon.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.check-mark {
  width: 16rpx;
  height: 10rpx;
  border-left: 3rpx solid #FFF8E7;
  border-bottom: 3rpx solid #FFF8E7;
  transform: rotate(-45deg);
  margin-top: -4rpx;
}

.item-checkbox {
  padding: 10rpx;
  margin-right: 14rpx;
}

/* ===== 商品内容 ===== */
.item-content {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  margin-right: 20rpx;
  flex-shrink: 0;
  background-color: var(--color-bg-secondary);
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.item-name {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 6rpx;
}

.item-spec {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stock-warning {
  margin-bottom: 8rpx;
}

.warning-text {
  font-size: 20rpx;
  color: var(--color-danger);
  background-color: #FFF5F2;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.item-price {
  font-size: var(--font-lg);
  color: var(--color-price);
  font-weight: 700;
  flex-shrink: 0;
}

/* ===== 数量控制器 ===== */
.quantity-control {
  display: flex;
  align-items: center;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-full);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-bg-secondary);
}

.qty-btn {
  width: 52rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-primary);
}

.qty-btn.disabled {
  color: var(--color-text-disabled);
}

.qty-input {
  width: 56rpx;
  height: 48rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  padding: 0;
  background: var(--color-bg-card);
}

/* ===== 删除按钮 ===== */
.item-delete-btn {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  color: var(--color-text-hint);
  border-radius: 8rpx;
}

.item-delete-btn:active {
  color: var(--color-danger);
  background: #FFF5F2;
}

/* ===== 底部操作栏 ===== */
.cart-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 252, 246, 0.96);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-up);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 20rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.footer-left {
  display: flex;
  align-items: center;
}

.select-all {
  display: flex;
  align-items: center;
  margin-right: 32rpx;
}

.select-all-text {
  font-size: var(--font-base);
  color: var(--color-text);
  margin-left: 10rpx;
}

.batch-delete {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
  padding: 10rpx 16rpx;
}

.footer-right {
  display: flex;
  align-items: center;
}

.total-info {
  margin-right: 20rpx;
}

.total-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.total-price {
  font-size: 36rpx;
  color: var(--color-price);
  font-weight: bold;
}

.checkout-btn {
  width: 200rpx;
  height: 76rpx;
  background: var(--gradient-brand);
  color: #FFF8E7;
  border-radius: 38rpx;
  font-size: 27rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 18rpx rgba(91, 58, 41, 0.25);
  padding: 0;
  margin: 0;
}

.checkout-btn::after { border: none; }

.checkout-btn.disabled {
  background: var(--color-text-disabled);
  box-shadow: none;
}
