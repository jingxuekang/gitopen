<!-- pages/login/login.wxml -->
<view class="login-page">
  <view class="login-header">
    <text class="back-btn" bindtap="goBack">←</text>
    <text class="header-title">报告茶友</text>
  </view>

  <view class="brand-wrap">
    <view class="logo-row">
      <view class="logo-mark">茶</view>
      <view class="logo-text-wrap">
        <text class="brand-logo">茶友会</text>
        <text class="brand-subtitle">福 鼎 白 茶</text>
      </view>
    </view>
  </view>

  <view class="btn-group">
    <button
      class="primary-btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
      loading="{{loading}}"
      disabled="{{loading}}"
    >
      {{loading ? '登录中...' : '手机号一键登录'}}
    </button>
    <button class="ghost-btn" bindtap="onFeatureComingSoon">手机号码登录/注册</button>
  </view>

  <view class="agreement-row" bindtap="toggleAgree">
    <view class="checkbox {{agreed ? 'checked' : ''}}">
      <text wx:if="{{agreed}}" class="check-mark">✓</text>
    </view>
    <text class="agreement-text">
      我已阅读并同意
      <text class="agreement-link">《用户协议》</text>
      、
      <text class="agreement-link">《隐私政策》</text>
    </text>
  </view>

  <text class="skip-text" bindtap="goHome">暂不登录</text>
</view>
