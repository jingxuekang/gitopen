/* pages/category/category.wxss */
.category-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #F5EBD9 0%, #F8F4EC 100%);
  box-sizing: border-box;
  padding-bottom: calc(106rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.nav-placeholder {
  height: 0;
  flex-shrink: 0;
}

.category-body {
  display: flex;
  flex: 1;
  overflow: hidden;
  min-height: 0;
}

.category-sidebar {
  width: 140rpx;
  background: #F2EADB;
  border-right: 1rpx solid #E6D8C2;
  padding: 8rpx 0;
  overflow-y: auto;
  flex-shrink: 0;
}

.category-item {
  margin: 8rpx 10rpx;
  min-height: 80rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 26rpx;
  color: #7C6E5D;
  line-height: 1.3;
  padding: 10rpx 6rpx;
}

.category-item.active {
  background: linear-gradient(135deg, #83643D 0%, #644A2D 100%);
  color: #FFF7E8;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(88, 63, 34, 0.22);
}

.content-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  overflow: hidden;
}

.first-level-nav {
  display: flex;
  align-items: center;
  gap: 10rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding: 14rpx 16rpx 12rpx;
  background: rgba(248, 244, 236, 0.94);
  border-bottom: 1rpx solid #EADDCA;
}

.first-level-item {
  height: 58rpx;
  border-radius: 29rpx;
  border: 1rpx solid #E4D6C1;
  background: #FFFFFF;
  color: #726555;
  font-size: 24rpx;
  padding: 0 22rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.first-level-item.active {
  color: #FFFFFF;
  border-color: transparent;
  background: linear-gradient(135deg, #83643D 0%, #644A2D 100%);
}

.filter-area {
  margin: 10rpx 12rpx 0;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #ECE0CF;
  box-shadow: 0 8rpx 24rpx rgba(77, 54, 30, 0.06);
  max-height: 42vh;
  overflow-y: auto;
}

.filter-group {
  border-bottom: 1rpx solid #EFE5D6;
}

.filter-group:last-child {
  border-bottom: none;
}

.filter-header {
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.filter-title-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.filter-name {
  font-size: 25rpx;
  color: #3D3329;
  font-weight: 600;
}

.filter-selected-tag {
  max-width: 280rpx;
  font-size: 21rpx;
  color: #8A6437;
  border: 1rpx solid #E3CFB0;
  background: #FBF2E4;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-icon {
  font-size: 18rpx;
  color: #9F9383;
  transform: rotate(0deg);
  transition: transform 0.24s ease;
}

.filter-icon.expanded {
  transform: rotate(180deg);
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  max-height: 0;
  overflow: hidden;
  padding: 0 20rpx;
  transition: all 0.26s ease;
}

.filter-options.show {
  max-height: 900rpx;
  padding: 0 20rpx 16rpx;
}

.filter-option {
  min-height: 52rpx;
  max-width: 100%;
  border-radius: 999rpx;
  border: 1rpx solid #E6DAC8;
  background: #F9F5EE;
  color: #675A4B;
  font-size: 23rpx;
  padding: 8rpx 18rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.filter-option-icon {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 1rpx solid #E4D8C6;
}

.filter-option.active {
  background: linear-gradient(135deg, #83643D 0%, #644A2D 100%);
  border-color: transparent;
  color: #FFF8EA;
}

.product-list {
  flex: 1;
  overflow-y: auto;
}

.product-grid {
  padding: 12rpx 10rpx 24rpx;
  display: flex;
  flex-wrap: wrap;
}

.loading {
  text-align: center;
  color: #917F69;
  font-size: 24rpx;
  padding: 28rpx 0;
}

.no-more {
  text-align: center;
  color: #A49686;
  font-size: 23rpx;
  padding: 20rpx 0 30rpx;
}

.empty-state {
  margin: 14rpx 12rpx 24rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(77, 54, 30, 0.06);
  text-align: center;
  padding: 80rpx 20rpx;
}

.empty-state image {
  width: 156rpx;
  height: 156rpx;
  opacity: 0.78;
  margin-bottom: 18rpx;
}

.empty-state text {
  font-size: 26rpx;
  color: #887C6F;
}
