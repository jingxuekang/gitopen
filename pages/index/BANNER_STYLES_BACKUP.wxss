/* 轮播图 - 3D堆叠卡片效果 - 请复制此样式到 index.wxss 中替换损坏的部分 */

.banner-swiper {
  width: 100%;
  height: 400rpx;
  margin: 20rpx 0 24rpx 0;
  overflow: visible;
}

.banner-item {
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.banner-card {
  width: calc(100% - 48rpx);
  height: 360rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(61, 40, 23, 0.15);
  transition: all 0.3s ease;
  transform: scale(0.85);
  opacity: 0.6;
}

.banner-item.swiper-item-active .banner-card {
  transform: scale(1);
  opacity: 1;
  box-shadow: 0 20rpx 48rpx rgba(61, 40, 23, 0.25);
}

.banner-image {
  width: 100%;
  height: 100%;
}
