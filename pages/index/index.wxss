/* pages/index/index.wxss */
.index-page {
  background: linear-gradient(180deg, #F9F6F1 0%, #F5F0E8 100%);
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* v??*/
.home-header {
  margin: 0;
  padding: 0 24rpx 16rpx;
  border-radius: 0;
  background: linear-gradient(135deg, #8B6914 0%, #A67C1A 50%, #8B6914 100%);
  box-shadow: 0 4rpx 20rpx rgba(139, 105, 20, 0.25);
  box-sizing: border-box;
  position: relative;
}

.status-bar-placeholder {
  height: env(safe-area-inset-top);
  min-height: 44px;
}

.header-action-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0 0;
  gap: 12rpx;
}

.header-search-row {
  height: 72rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.brand-logo {
  width: 48rpx;
  height: 48rpx;
  border-radius: 10rpx;
  margin-right: 12rpx;
  background: rgba(255, 255, 255, 0.14);
}

.brand-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFF8E8;
  letter-spacing: 2rpx;
}

.header-main-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 0;
}

.header-location {
  display: flex;
  align-items: center;
  width: 220rpx;
  flex-shrink: 0;
  height: 68rpx;
  padding: 0 16rpx 0 14rpx;
  border-radius: 36rpx;
  background: rgba(255, 248, 231, 0.22);
  border: 1rpx solid rgba(255, 248, 231, 0.4);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
}

.location-pin {
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid #FFF2D5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.location-pin-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #FFF2D5;
}

.location-name {
  flex: 1;
  min-width: 0;
  margin: 0 10rpx;
  font-size: 25rpx;
  color: #FFF9EC;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.location-arrow {
  flex-shrink: 0;
  font-size: 24rpx;
  color: rgba(255, 239, 210, 0.9);
  line-height: 1;
}

.header-search {
  height: 68rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  padding: 0 20rpx;
}

.search-icon-wrap {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  position: relative;
  flex-shrink: 0;
}

.search-icon-circle {
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #8B92A2;
  border-radius: 50%;
  box-sizing: border-box;
  position: absolute;
  left: 1rpx;
  top: 1rpx;
}

.search-icon-handle {
  width: 9rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #8B92A2;
  position: absolute;
  right: 0;
  bottom: 4rpx;
  transform: rotate(40deg);
  transform-origin: right center;
}

.search-keyword {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #8C919C;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 轮播图 - 3D堆叠卡片效果 */

/* 轮播图 - 3D堆叠卡片效果 */
.banner-swiper {
  width: calc(100% - 48rpx);
  height: 380rpx;
  margin: 20rpx 24rpx 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(61, 40, 23, 0.1);
}

.banner-item {
  width: 100%;
  height: 100%;
}

.banner-card {
  width: 100%;
  height: 100%;
  border-radius: 0;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
}
.trace-header {
  margin: 20rpx 24rpx 12rpx;
}

.trace-title {
  font-size: 32rpx;
  color: #3D2817;
  font-weight: 700;
  letter-spacing: 3rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.05);
}

/* {e?*/
.category-grid {
  display: flex;
  padding: 16rpx 0 8rpx;
  margin: 0;
}

.category-grid::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, transparent, #D4AF37, transparent);
}

.category-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  transition: transform 0.3s ease;
}

.category-item:active {
  transform: scale(0.95);
}

.category-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 16rpx;
  border-radius: 50%;
  box-shadow: 0 6rpx 16rpx rgba(139, 105, 20, 0.2);
}

.category-name {
  font-size: 28rpx;
  color: #3D2817;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* :W */
.section {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF5 100%);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(61, 40, 23, 0.1);
  position: relative;
  overflow: hidden;
}

.section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #D4AF37, transparent);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid rgba(139, 105, 20, 0.1);
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3D2817;
  position: relative;
  padding-left: 20rpx;
  letter-spacing: 2rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #D4AF37 0%, #8B6914 100%);
  border-radius: 3rpx;
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #8B6914;
  font-weight: 500;
}

.arrow-text {
  margin-left: 6rpx;
  font-size: 28rpx;
  line-height: 1;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.home-product-card {
  display: block;
  width: calc(50% - 16rpx);
  margin: 8rpx;
}

.ranking-section {
  margin: 0 24rpx 24rpx;
}

.rank-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.rank-tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6B5A47;
  background: #F5F0E8;
  border-radius: 32rpx;
  transition: all 0.3s ease;
  font-weight: 500;
}

.rank-tab.active {
  background: linear-gradient(135deg, #8B6914 0%, #A67C1A 100%);
  color: #FFF8E8;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(139, 105, 20, 0.3);
}

.rank-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #FFFBF5;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.rank-item:active {
  background: #FFF8ED;
  transform: scale(0.98);
}

.rank-number {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #8B6914;
  background: linear-gradient(135deg, #FFF4D9 0%, #FFE8B8 100%);
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rank-number.top {
  background: linear-gradient(135deg, #D4AF37 0%, #F4D03F 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(212, 175, 55, 0.4);
}

.rank-product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rank-product-info {
  flex: 1;
  min-width: 0;
}

.rank-product-name {
  font-size: 28rpx;
  color: #3D2817;
  font-weight: 600;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-product-desc {
  font-size: 24rpx;
  color: #8B7A6A;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-product-price {
  font-size: 32rpx;
  color: #B5702E;
  font-weight: 700;
}

.rank-product-sales {
  font-size: 22rpx;
  color: #A89888;
  margin-left: 12rpx;
}

.skeleton-banner {
  width: calc(100% - 48rpx);
  height: 380rpx;
  margin: 20rpx 24rpx 24rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #F0F0F0 25%, #E0E0E0 50%, #F0F0F0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
}

.skeleton-categories {
  display: flex;
  justify-content: space-around;
  padding: 32rpx 24rpx 28rpx;
  margin: 0 24rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.skeleton-category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.skeleton-category-item::before {
  content: '';
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #F0F0F0 25%, #E0E0E0 50%, #F0F0F0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  margin-bottom: 16rpx;
}

.skeleton-category-item::after {
  content: '';
  width: 80rpx;
  height: 28rpx;
  border-radius: 14rpx;
  background: linear-gradient(90deg, #F0F0F0 25%, #E0E0E0 50%, #F0F0F0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
}

@keyframes skeleton-loading {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

.tap-active {
  transition: opacity 0.2s ease;
}

.tap-active:active {
  opacity: 0.7;
}

.safe-area-top {
  padding-top: env(safe-area-inset-top);
}

/* 新排行榜样式 */
.ranking-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #FFFBF5;
  border-radius: 20rpx;
  position: relative;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 16rpx rgba(139, 105, 20, 0.08);
}

.ranking-item:active {
  background: #FFF8ED;
  transform: scale(0.98);
}

/* 前三名奖牌样式 */
.rank-medal {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.medal-1 {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  box-shadow: 0 4rpx 16rpx rgba(255, 215, 0, 0.5);
}

.medal-2 {
  background: linear-gradient(135deg, #E8E8E8 0%, #C0C0C0 100%);
  box-shadow: 0 4rpx 16rpx rgba(192, 192, 192, 0.5);
}

.medal-3 {
  background: linear-gradient(135deg, #CD7F32 0%, #B87333 100%);
  box-shadow: 0 4rpx 16rpx rgba(205, 127, 50, 0.5);
}

.medal-number {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

/* 第四名及以后的普通数字 */
.rank-number-normal {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #8B6914;
  background: #F5F0E8;
}

.ranking-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
  object-fit: cover;
}

.ranking-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 140rpx;
  padding: 4rpx 0;
}

.ranking-name {
  font-size: 30rpx;
  color: #3D2817;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.4;
  margin-bottom: 0;
}

.ranking-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

.ranking-price {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.ranking-price .price-symbol {
  font-size: 24rpx;
  color: #B5702E;
  font-weight: 600;
}

.ranking-price .price-value {
  font-size: 38rpx;
  color: #B5702E;
  font-weight: 700;
}

.ranking-stats {
  font-size: 22rpx;
  color: #A89888;
  padding: 6rpx 14rpx;
  background: rgba(139, 105, 20, 0.07);
  border-radius: 20rpx;
}

