/* pages/search/search.wxss */
.search-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F5EBD9 0%, #F8F4EC 100%);
  color: #2F2A22;
}

.search-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx;
  background: rgba(248, 244, 236, 0.98);
  backdrop-filter: blur(4rpx);
}

.search-input-wrapper {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8DAC3;
  box-shadow: 0 8rpx 20rpx rgba(77, 54, 30, 0.05);
  padding: 0 24rpx;
  display: flex;
  align-items: center;
}

.search-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 14rpx;
  opacity: 0.58;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #3A3128;
}

.search-btn {
  min-width: 118rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #81653E 0%, #634A2D 100%);
  color: #FFF8EA;
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
}

.search-suggestions {
  padding: 8rpx 20rpx 24rpx;
}

.suggestion-section {
  margin-top: 14rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(77, 54, 30, 0.06);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 30rpx;
  color: #2F2A22;
  font-weight: 600;
}

.clear-btn {
  font-size: 23rpx;
  color: #917D66;
}

.keyword-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.keyword-item {
  max-width: 100%;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #F7F1E7;
  border: 1rpx solid #E9DDCB;
  color: #6A5E50;
  font-size: 24rpx;
  line-height: 1.4;
}

.keyword-item.hot {
  background: #FFF1DB;
  border-color: #E6CEA6;
  color: #966433;
}

.search-results {
  padding: 8rpx 20rpx 24rpx;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty-state {
  margin-top: 12rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(77, 54, 30, 0.06);
  padding: 110rpx 24rpx;
  text-align: center;
}

.empty-state image {
  width: 180rpx;
  height: 180rpx;
  opacity: 0.85;
  margin-bottom: 22rpx;
}

.empty-state text {
  display: block;
  font-size: 28rpx;
  color: #74695C;
}

.empty-tip {
  margin-top: 10rpx;
  font-size: 23rpx !important;
  color: #A19382 !important;
}

.loading {
  padding: 8rpx 20rpx 20rpx;
}
