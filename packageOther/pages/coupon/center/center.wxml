<view class="container">
  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="loading-text">优惠券加载中...</text>
  </view>

  <view wx:elif="{{coupons.length === 0}}" class="empty-wrap">
    <view class="empty-icon">券</view>
    <text class="empty-title">暂无可领取优惠券</text>
    <text class="empty-desc">活动券上新后会展示在这里</text>
    <button class="my-coupon-btn" bindtap="onBackMyCoupons">查看我的优惠券</button>
  </view>

  <view wx:else class="list-wrap">
    <coupon-card
      wx:for="{{coupons}}"
      wx:key="_id"
      coupon="{{item.cardData}}"
      status="available"
      actionText="{{claimingId === item._id ? '领取中' : '立即领取'}}"
      bind:action="onClaimCoupon"
    />
  </view>
</view>
