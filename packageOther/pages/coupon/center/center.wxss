.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #F5EBD9 0%, #F8F4EC 100%);
  padding: 16rpx 20rpx 24rpx;
  box-sizing: border-box;
}

.loading-wrap,
.empty-wrap {
  margin-top: 4rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(77, 54, 30, 0.06);
  min-height: 480rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-text {
  font-size: 27rpx;
  color: #857865;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  border: 2rpx solid #D8BE97;
  background: linear-gradient(135deg, #FFF7E9 0%, #F5E5CE 100%);
  color: #8A6337;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 28rpx;
  color: #5F513F;
  font-weight: 600;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9A8D7C;
}

.my-coupon-btn {
  margin-top: 28rpx;
  min-width: 280rpx;
  height: 78rpx;
  border-radius: 39rpx;
  border: none;
  background: linear-gradient(135deg, #83643D 0%, #644A2D 100%);
  color: #FFF8EA;
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
}

.my-coupon-btn::after {
  border: none;
}

.list-wrap {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
