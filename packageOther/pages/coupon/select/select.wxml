<!-- 优惠券选择页面 -->
<view class="container">
  <view wx:if="{{loading}}" class="loading">
    <skeleton type="list" count="3"></skeleton>
  </view>

  <view wx:elif="{{coupons.length === 0}}" class="empty">
    <view class="empty-icon">券</view>
    <text class="empty-text">暂无可用优惠券</text>
  </view>

  <view wx:else class="coupons-list">
    <!-- 不使用优惠券选项 -->
    <view class="coupon-item {{!selectedCouponId ? 'selected' : ''}}" bindtap="onSelectCoupon" data-id="">
      <view class="coupon-content">
        <text class="no-coupon-text">不使用优惠券</text>
      </view>
      <view class="check-icon">{{!selectedCouponId ? '✓' : ''}}</view>
    </view>

    <!-- 优惠券列表 -->
    <coupon-card
      wx:for="{{coupons}}"
      wx:key="_id"
      coupon="{{item.cardData}}"
      status="{{item.available ? 'available' : 'expired'}}"
      selectable="{{true}}"
      selected="{{selectedCouponId === item._id}}"
      showAction="{{false}}"
      bind:select="onSelectCoupon"
    />
  </view>

  <!-- 底部确认按钮 -->
  <view class="bottom-bar">
    <button class="confirm-btn" bindtap="onConfirm">确定</button>
  </view>
</view>
