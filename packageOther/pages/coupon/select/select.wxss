/* pages/coupon/select/select.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #F5EBD9 0%, #F8F4EC 100%);
  padding: 0;
  padding-bottom: calc(118rpx + env(safe-area-inset-bottom));
}

.loading,
.empty {
  margin: 16rpx 20rpx 0;
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(77, 54, 30, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 110rpx 24rpx;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  border: 2rpx solid #D8BE97;
  background: linear-gradient(135deg, #FFF7E9 0%, #F5E5CE 100%);
  color: #8A6337;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 27rpx;
  color: #807364;
}

.coupons-list {
  padding: 16rpx 20rpx 8rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.coupon-item {
  border-radius: 18rpx;
  border: 1rpx solid #E8DBC7;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(77, 54, 30, 0.05);
  padding: 22rpx;
  display: flex;
  align-items: center;
}

.coupon-item.selected {
  border-color: #D5B385;
  background: #FFF6E8;
}

.coupon-item.disabled {
  opacity: 0.45;
}

.coupon-content {
  flex: 1;
  min-width: 0;
}

.no-coupon-text {
  font-size: 28rpx;
  color: #3A3229;
}

.check-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 1rpx solid #D8CCB8;
  background: #FFFFFF;
  color: transparent;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}

.coupon-item.selected .check-icon {
  border-color: #8A6640;
  background: #8A6640;
  color: #FFFFFF;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
  background: #FFFCF6;
  border-top: 1rpx solid #E8D9BF;
}

.confirm-btn {
  width: 100%;
  height: 84rpx;
  border-radius: 42rpx;
  border: none;
  background: linear-gradient(135deg, #83643D 0%, #644A2D 100%);
  color: #FFF8EA;
  font-size: 28rpx;
  font-weight: 600;
}

.confirm-btn::after {
  border: none;
}
