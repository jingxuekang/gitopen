/* pages/group/list/list.wxss */
.group-list-page {
  min-height: 100vh;
  background-color: #F7F4F0;
  padding-bottom: 40rpx;
}

/* 页面头部 */
.page-header {
  background: linear-gradient(135deg, #5B3A29 0%, #7A5233 100%);
  padding: 40rpx 30rpx 50rpx;
  color: white;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
}

/* 活动列表 */
.activity-list {
  padding: 20rpx 30rpx;
}

.activity-item {
  margin-bottom: 30rpx;
}

.activity-card {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 商品图片 */
.product-image {
  width: 100%;
  height: 400rpx;
  display: block;
}

/* 商品信息 */
.product-info {
  padding: 30rpx;
}

.product-name {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 价格区域 */
.price-section {
  display: flex;
  align-items: flex-end;
  margin-bottom: 20rpx;
}

.group-price-box {
  flex: 1;
}

.price-label {
  display: block;
  font-size: 24rpx;
  color: #FF6B6B;
  margin-bottom: 8rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 28rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.price-value {
  font-size: 48rpx;
  color: #FF6B6B;
  font-weight: bold;
  margin-left: 4rpx;
}

.original-price-box {
  margin-left: 20rpx;
}

.original-price {
  font-size: 28rpx;
  color: #999;
  text-decoration: line-through;
}

/* 拼团信息 */
.group-info {
  display: flex;
  align-items: center;
  margin-bottom: 25rpx;
}

.group-tag {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: white;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin-right: 20rpx;
}

.stock-info {
  font-size: 24rpx;
  color: #999;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
}

.action-buttons button {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #5B3A29 0%, #7A5233 100%);
  color: white;
}

.btn-secondary {
  background: white;
  color: #5B3A29;
  border: 2rpx solid #5B3A29 !important;
}

/* 加载状态 */
.loading-container {
  padding: 80rpx 0;
  text-align: center;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 空状态 */
.empty-container {
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 40rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.empty-hint {
  display: block;
  font-size: 28rpx;
  color: #999;
}

/* 没有更多 */
.no-more {
  padding: 40rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}
