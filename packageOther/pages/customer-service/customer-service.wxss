page {
  background: #F7F4F0;
}

.container {
  height: 100vh;
  background: #F7F4F0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 顶部状态栏 ===== */

.status-bar {
  margin: 20rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(77, 53, 36, 0.06);
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.status-dot.online {
  background: #3AB46D;
  box-shadow: 0 0 8rpx rgba(58, 180, 109, 0.4);
}

.status-dot.offline {
  background: #C8B8A0;
}

.status-text-wrap {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.status-title {
  font-size: 30rpx;
  color: #4D3524;
  font-weight: 600;
  line-height: 1.3;
}

.status-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #8E7962;
  line-height: 1.4;
}

/* ===== 消息区域 ===== */

.messages-container {
  flex: 1;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
  overflow-y: auto;
}

.message-item {
  display: flex;
  margin-bottom: 28rpx;
  align-items: flex-start;
}

.user-message {
  flex-direction: row-reverse;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #E4DBCE;
  overflow: hidden;
}

.avatar-service,
.avatar-user {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.avatar-service {
  color: #FFF8E7;
  background: linear-gradient(135deg, #5B3A29 0%, #8B6914 100%);
}

.avatar-user {
  color: #6E563E;
  background: #E9DFD2;
}

.message-content {
  max-width: 520rpx;
  margin: 0 16rpx;
}

.user-message .message-content {
  display: flex;
  justify-content: flex-end;
}

.text-content {
  padding: 20rpx 24rpx;
  border-radius: 4rpx 20rpx 20rpx 20rpx;
  background: #FFFFFF;
  color: #4D3524;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.user-message .text-content {
  background: linear-gradient(135deg, #8B6914 0%, #A07B1A 100%);
  color: #FFF8E7;
  border-radius: 20rpx 4rpx 20rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(139, 105, 20, 0.2);
}

.image-content {
  max-width: 100%;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* ===== 常见问题 ===== */

.faq-section {
  margin-bottom: 24rpx;
}

.faq-header {
  margin-bottom: 14rpx;
}

.faq-title {
  font-size: 26rpx;
  color: #7A634B;
  font-weight: 500;
}

.faq-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(77, 53, 36, 0.06);
}

.faq-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #F2ECE3;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-item:active {
  background: #FBF8F4;
}

.faq-question {
  flex: 1;
  font-size: 28rpx;
  color: #4D3524;
  line-height: 1.5;
}

.faq-arrow {
  margin-left: 12rpx;
  font-size: 32rpx;
  color: #B59F87;
}

/* ===== 底部输入栏 ===== */

.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 24rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 20rpx rgba(77, 53, 36, 0.06);
  position: relative;
  z-index: 10;
}

.action-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #F5EFE5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.action-btn:active {
  background: #E9DFD2;
}

.action-icon {
  font-size: 38rpx;
  color: #8B6914;
  line-height: 1;
  font-weight: 300;
}

.input-wrap {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border-radius: 36rpx;
  background: #F5F2ED;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.message-input {
  width: 100%;
  height: 100%;
  font-size: 28rpx;
  color: #4D3524;
}

.input-placeholder {
  color: #BBA98E;
  font-size: 28rpx;
}

.send-btn {
  height: 68rpx;
  padding: 0 30rpx;
  border-radius: 34rpx;
  background: #E8E0D4;
  color: #B7A48D;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.send-btn-active {
  background: linear-gradient(135deg, #8B6914 0%, #A68523 100%);
  color: #FFFBF0;
  box-shadow: 0 4rpx 16rpx rgba(139, 105, 20, 0.35);
}

.send-btn-active:active {
  opacity: 0.85;
}
