/* pages/user/address/edit/edit.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #F5EBD9 0%, #F8F4EC 100%);
  padding: 16rpx 20rpx calc(130rpx + env(safe-area-inset-bottom));
}

.form {
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 10rpx 28rpx rgba(77, 54, 30, 0.06);
  overflow: hidden;
}

.form-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #EFE5D6;
  display: flex;
  align-items: center;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item.textarea-item {
  align-items: flex-start;
}

.form-item.switch-item {
  justify-content: space-between;
}

.label {
  width: 170rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  font-weight: 600;
  color: #3B3228;
}

.label.required::before {
  content: '*';
  margin-right: 4rpx;
  color: #D85A4B;
}

.input {
  flex: 1;
  height: 66rpx;
  border-radius: 12rpx;
  background: #F7F2E9;
  border: 1rpx solid #ECE1D0;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #3F362D;
}

.picker {
  flex: 1;
}

.picker-value {
  min-height: 66rpx;
  border-radius: 12rpx;
  background: #F7F2E9;
  border: 1rpx solid #ECE1D0;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #3F362D;
}

.picker-value .placeholder {
  color: #9D9183;
}

.arrow {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #9D9183;
}

.textarea {
  flex: 1;
  min-height: 140rpx;
  border-radius: 12rpx;
  background: #F7F2E9;
  border: 1rpx solid #ECE1D0;
  padding: 14rpx 16rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: #3F362D;
}

.submit-section {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
  background: #FFFCF6;
  border-top: 1rpx solid #E8D9BF;
}

.submit-button {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border: none;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #83643D 0%, #644A2D 100%);
  color: #FFF8EA;
  font-size: 29rpx;
  font-weight: 600;
}

.submit-button::after {
  border: none;
}

.submit-button[disabled] {
  background: #D7D1C8;
  color: #FFFFFF;
}
