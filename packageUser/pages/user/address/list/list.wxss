/* pages/user/address/list/list.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #F5EBD9 0%, #F8F4EC 100%);
  padding: 0;
  padding-bottom: calc(126rpx + env(safe-area-inset-bottom));
}

.loading {
  margin: 18rpx 20rpx 0;
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(77, 54, 30, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 280rpx;
}

.address-list {
  padding: 16rpx 20rpx 6rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty {
  margin: 16rpx 20rpx 0;
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(77, 54, 30, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 110rpx 24rpx;
}

.empty-icon {
  width: 168rpx;
  height: 168rpx;
  opacity: 0.8;
  margin-bottom: 22rpx;
}

.empty-text {
  font-size: 27rpx;
  color: #807364;
  margin-bottom: 28rpx;
}

.add-button {
  min-width: 280rpx;
  height: 80rpx;
  border-radius: 40rpx;
  border: none;
  background: linear-gradient(135deg, #83643D 0%, #644A2D 100%);
  color: #FFF8EA;
  font-size: 27rpx;
  font-weight: 600;
  padding: 0 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-button::after {
  border: none;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
  background: #FFFCF6;
  border-top: 1rpx solid #E8D9BF;
}

.add-address-button {
  width: 100%;
  height: 84rpx;
  border-radius: 42rpx;
  border: none;
  background: linear-gradient(135deg, #83643D 0%, #644A2D 100%);
  color: #FFF8EA;
  font-size: 28rpx;
  font-weight: 600;
}

.add-address-button::after {
  border: none;
}
