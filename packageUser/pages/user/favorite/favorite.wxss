/* pages/user/favorite/favorite.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #F5EBD9 0%, #F8F4EC 100%);
  padding: 0 0 calc(120rpx + env(safe-area-inset-bottom)) 0;
}

.loading,
.empty {
  margin: 16rpx 20rpx 0;
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(77, 54, 30, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 110rpx 24rpx;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  border: 2rpx solid #D8BE97;
  background: linear-gradient(135deg, #FFF7E9 0%, #F5E5CE 100%);
  color: #8A6337;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #7D7164;
  margin-bottom: 30rpx;
}

.go-shopping-btn {
  min-width: 280rpx;
  height: 78rpx;
  border-radius: 39rpx;
  border: none;
  background: linear-gradient(135deg, #83643D 0%, #644A2D 100%);
  color: #FFF8EA;
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
}

.go-shopping-btn::after {
  border: none;
}

.favorites-list {
  padding: 16rpx 20rpx calc(20rpx + env(safe-area-inset-bottom));
}

.favorite-item {
  margin-bottom: 18rpx;
}

.actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
}

.action-btn {
  min-width: 182rpx;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 31rpx;
  border: 1rpx solid #DECDB2;
  background: #FFF7EA;
  color: #7B664C;
  font-size: 23rpx;
  padding: 0 24rpx;
}

.action-btn.remove {
  background: #FFF7EA;
  color: #7B664C;
}

.no-more {
  text-align: center;
  color: #A29380;
  font-size: 22rpx;
  padding: 16rpx 0 calc(24rpx + env(safe-area-inset-bottom));
}
