/* pages/user/settings/settings.wxss */
.settings-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F5EBD9 0%, #F8F4EC 100%);
  padding: 16rpx 20rpx 30rpx;
}

.group {
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(77, 54, 30, 0.06);
  overflow: hidden;
}

.item {
  min-height: 92rpx;
  padding: 0 22rpx;
  border-bottom: 1rpx solid #EFE5D6;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item:last-child {
  border-bottom: none;
}

.item-name {
  font-size: 28rpx;
  color: #2F2A22;
}

.arrow {
  font-size: 30rpx;
  color: #A09383;
}

.logout-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  border: 1rpx solid #E1D1B8;
  background: #FFF8EA;
  color: #7A5B36;
  font-size: 28rpx;
  font-weight: 600;
}

.logout-btn::after {
  border: none;
}

.version {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B0A18F;
}
